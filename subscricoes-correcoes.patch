@@ -0,0 +1,73 @@
+<?php
+
+namespace Modules\Subscricoes\Http\Controllers\Admin;
+
+use DomainException;
+use Illuminate\Http\RedirectResponse;
+use Illuminate\Http\Request;
+use Illuminate\Routing\Controller;
+use Illuminate\View\View;
+use Modules\Core\Services\TenantManager;
+use Modules\Subscricoes\Models\DocumentoFiscal;
+use Modules\Subscricoes\Services\Fiscal\DocumentoFiscalService;
+
+/**
+ * Acompanhamento dos documentos fiscais das subscrições — só super admins.
+ */
+class DocumentoFiscalController extends Controller
+{
+    public function __construct(
+        protected DocumentoFiscalService $servico,
+        protected TenantManager $tenantManager,
+    ) {}
+
+    public function index(Request $request): View
+    {
+        abort_unless($request->user()?->is_super_admin, 403);
+
+        $documentos = $this->tenantManager->semTenant(fn () => DocumentoFiscal::withoutGlobalScopes()
+            ->with(['empresa', 'pagamento'])
+            ->latest('id')
+            ->limit(200)
+            ->get());
+
+        return view('subscricoes::admin.documentos-fiscais', [
+            'documentos' => $documentos,
+            'driver' => config('subscricoes.fiscal.driver', 'manual'),
+        ]);
+    }
+
+    public function registar(Request $request, int $documento): RedirectResponse
+    {
+        abort_unless($request->user()?->is_super_admin, 403);
+
+        $dados = $request->validate(['numero_documento' => ['required', 'string', 'max:60']]);
+
+        return $this->executar(fn () => $this->servico->registarExterno($this->obter($documento), $dados['numero_documento']),
+            'Número do documento fiscal registado.');
+    }
+
+    public function reemitir(Request $request, int $documento): RedirectResponse
+    {
+        abort_unless($request->user()?->is_super_admin, 403);
+
+        return $this->executar(fn () => $this->servico->reemitir($this->obter($documento)),
+            'Documento marcado para reemissão com novo número.');
+    }
+
+    protected function obter(int $id): DocumentoFiscal
+    {
+        return $this->tenantManager->semTenant(fn () => DocumentoFiscal::withoutGlobalScopes()->findOrFail($id));
+    }
+
+    protected function executar(callable $acao, string $sucesso): RedirectResponse
+    {
+        try {
+            $this->tenantManager->semTenant($acao);
+        } catch (DomainException $e) {
+            return back()->with('erro', $e->getMessage());
+        }
+
+        return back()->with('sucesso', $sucesso);
+    }
+}
