new file mode 100644
index 0000000..2acb1e6
--- /dev/null
+++ b/Modules/Subscricoes/app/Services/Fiscal/AgtSeriesService.php
@@ -0,0 +1,96 @@
+<?php
+
+namespace Modules\Subscricoes\Services\Fiscal;
+
+use DomainException;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Str;
+
+/**
+ * solicitarSerie (AGT): cria uma série de numeração de faturas eletrónicas e
+ * guarda o código e a gama autorizada. Documentação:
+ * https://quiosqueagt.minfin.gov.ao/doc-agt/doc-agt/2/servicos/servicos_solicitar_criacao.html
+ *
+ * A assinatura do pedido (jwsSignature) usa os campos taxRegistrationNumber,
+ * seriesYear, documentType, establishmentNumber e seriesContingencyIndicator,
+ * pela ordem do exemplo da AGT. O texto da documentação lista só quatro destes
+ * campos: se a homologação responder E40, é aqui que se ajusta.
+ */
+class AgtSeriesService
+{
+    use ComunicaComAgt;
+
+    public function __construct(protected JwsAssinador $assinador) {}
+
+    /**
+     * @return array{serie: string, primeiro: int, ultimo: int}
+     *
+     * @throws DomainException quando a AGT recusa o pedido
+     */
+    public function solicitar(string $tipoDocumento, int $ano, string $estabelecimento = 'SEDE', bool $contingencia = false): array
+    {
+        $nif = $this->nifEmissor();
+        $indicador = $contingencia ? 'C' : 'N';
+
+        $payload = [
+            'schemaVersion' => '2.0',
+            'submissionUUID' => (string) Str::uuid(),
+            'taxRegistrationNumber' => $nif,
+            'submissionTimeStamp' => now()->utc()->format('Y-m-d\TH:i:s\Z'),
+            'softwareInfo' => $this->softwareInfo(),
+            'seriesYear' => $ano,
+            'documentType' => strtoupper($tipoDocumento),
+            'establishmentNumber' => $estabelecimento,
+            'jwsSignature' => $this->assinador->assinar([
+                'taxRegistrationNumber' => $nif,
+                'seriesYear' => (string) $ano,
+                'documentType' => strtoupper($tipoDocumento),
+                'establishmentNumber' => $estabelecimento,
+                'seriesContingencyIndicator' => $indicador,
+            ]),
+            'seriesContingencyIndicator' => $indicador,
+        ];
+
+        $resposta = $this->http()->post($this->url('solicitarSerie'), $payload);
+
+        if ($resposta->status() === 400 || ! empty(array_filter((array) $resposta->json('errorList')))) {
+            $erros = collect((array) $resposta->json('errorList'))
+                ->map(fn ($e) => is_array($e) ? trim(($e['idError'] ?? '?').': '.($e['descriptionError'] ?? '')) : (string) $e)
+                ->filter()
+                ->implode(' | ');
+
+            throw new DomainException('A AGT recusou o pedido de série: '.($erros ?: 'sem detalhe'));
+        }
+
+        if (! $resposta->successful()) {
+            throw new DomainException("A AGT respondeu HTTP {$resposta->status()} ao pedido de série.");
+        }
+
+        $resultado = (array) $resposta->json('seriesFEResult');
+        $codigo = (string) ($resultado['seriesCode'] ?? '');
+
+        if ($codigo === '') {
+            throw new DomainException('Resposta da AGT sem seriesCode.');
+        }
+
+        $primeiro = (int) ($resultado['firstDocumentNo'] ?? 1);
+        $ultimo = (int) ($resultado['lastDocumentNo'] ?? 0);
+
+        DB::table('series_fiscais')->updateOrInsert(
+            ['serie' => $codigo],
+            [
+                'ultimo_numero' => max(0, $primeiro - 1),
+                'tipo_documento' => strtoupper($tipoDocumento),
+                'ano' => $ano,
+                'estabelecimento' => $estabelecimento,
+                'contingencia' => $contingencia,
+                'primeiro_numero' => $primeiro,
+                'ultimo_autorizado' => $ultimo ?: null,
+                'created_at' => now(),
+                'updated_at' => now(),
+            ],
+        );
+
