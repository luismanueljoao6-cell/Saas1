+use Modules\Subscricoes\Models\Plano;
+use Modules\Subscricoes\Models\Subscricao;
+use Modules\Subscricoes\Services\Gateways\Contracts\GatewayPagamentoInterface;
+use Modules\Subscricoes\Services\PagamentoService;
+use Modules\Subscricoes\Services\SubscricaoService;
+use Tests\TestCase;
+
+class GatewayFalsoDoLote implements GatewayPagamentoInterface
+{
+    public function identificador(): string
+    {
+        return 'gateway-teste';
+    }
+
+    public function gerarReferencia(Pagamento $pagamento): array
+    {
+        return ['referencia_externa' => 'REF-'.$pagamento->id, 'payload' => ['entity_id' => '11223']];
+    }
+
+    public function validarPedidoWebhook(Request $request): bool
+    {
+        return true;
+    }
+
+    public function interpretarNotificacao(Request $request): array
+    {
+        return [
+            'referencia_externa' => (string) $request->input('reference'),
+            'estado' => 'confirmado',
+            'valor' => $request->input('amount'),
+            'payload' => $request->all(),
+        ];
+    }
+}
+
+class FuncionalidadesCompletasTest extends TestCase
+{
+    use RefreshDatabase;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        $this->withoutVite();
+        $this->app->instance(GatewayPagamentoInterface::class, new GatewayFalsoDoLote);
+        $this->app->forgetInstance(SubscricaoService::class);
+    }
+
+    /** @return array{0: Empresa, 1: Plano} */
+    protected function cenario(string $nif, array $planoExtra = []): array
+    {
+        $empresa = Empresa::create(['nome_comercial' => 'Empresa '.$nif, 'nif' => $nif]);
+        $plano = Plano::create(array_merge([
+            'nome' => 'Plano '.$nif,
+            'slug' => 'plano-'.$nif,
+            'preco' => 9900,
+            'periodo_dias' => 30,
+        ], $planoExtra));
+
+        return [$empresa->fresh(), $plano];
+    }
+
+    protected function utilizador(Empresa $empresa, string $sufixo): User
+    {
+        return User::create([
+            'empresa_id' => $empresa->id,
