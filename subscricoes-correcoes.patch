+<?php
+
+namespace Modules\Subscricoes\Console;
+
+use DomainException;
+use Illuminate\Console\Command;
+use Modules\Subscricoes\Services\Fiscal\AgtSeriesService;
+use Modules\Subscricoes\Services\Fiscal\JwsAssinador;
+use Throwable;
+
+class SolicitarSerieAgtCommand extends Command
+{
+    protected $signature = 'subscricoes:agt-serie
+                            {tipo=FR : Tipo de documento (FR, FT, NC...)}
+                            {--ano= : Ano da série (omissão: ano atual)}
+                            {--estabelecimento=SEDE : Estabelecimento registado no Portal do Contribuinte}
+                            {--contingencia : Série para emissão em contingência}';
+
+    protected $description = 'Pede à AGT a criação de uma série de numeração de faturas eletrónicas';
+
+    public function handle(): int
+    {
+        try {
+            $servico = new AgtSeriesService(JwsAssinador::doFicheiro(
+                (string) config('subscricoes.fiscal.agt.chave_privada_caminho'),
+                config('subscricoes.fiscal.agt.chave_privada_senha'),
+            ));
+
+            $resultado = $servico->solicitar(
+                (string) $this->argument('tipo'),
+                (int) ($this->option('ano') ?: now()->year),
+                (string) $this->option('estabelecimento'),
+                (bool) $this->option('contingencia'),
+            );
+        } catch (DomainException $e) {
+            $this->error($e->getMessage());
+
+            return self::FAILURE;
+        } catch (Throwable $e) {
+            $this->error('Falha ao contactar a AGT: '.$e->getMessage());
+
+            return self::FAILURE;
+        }
+
+        $this->info("Série criada: {$resultado['serie']} (números {$resultado['primeiro']} a {$resultado['ultimo']}).");
+        $this->line("Define no .env: SUBSCRICOES_FISCAL_SERIE={$resultado['serie']}");
+
+        return self::SUCCESS;
+    }
+}
