+<?php
+
+namespace Modules\Subscricoes\Enums;
+
+/**
+ * Estados de um Pagamento (ver SubscricaoEstado para a razão de não haver cast).
+ */
+enum PagamentoEstado: string
+{
+    case Pendente = 'pendente';
+    case Confirmado = 'confirmado';
+    case Falhado = 'falhado';
+    case Expirado = 'expirado';
+
+    public function e(?string $estado): bool
+    {
+        return $estado === $this->value;
+    }
+
+    /**
+     * Estados que exigem reconciliação manual para serem confirmados.
+     *
+     * @return array<int, string>
+     */
+    public static function reconciliaveis(): array
+    {
+        return [self::Expirado->value, self::Falhado->value];
+    }
+}
