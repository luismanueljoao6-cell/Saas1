+<?php
+
+namespace Modules\Subscricoes\Models;
+
+use Illuminate\Database\Eloquent\Model;
+
+/**
+ * Notificação recebida de um gateway de pagamento. Não pertence a nenhuma
+ * empresa (o gateway não sabe o que é uma empresa), por isso não usa
+ * BelongsToTenant — tal como o Plano.
+ */
+class EventoWebhook extends Model
+{
+    protected $table = 'eventos_webhook';
+
+    protected $fillable = [
+        'gateway',
+        'referencia_externa',
+        'valor',
+        'payload',
+        'estado',
+        'erro',
+        'processado_em',
+    ];
+
+    protected function casts(): array
+    {
+        return [
+            'payload' => 'array',
+            'processado_em' => 'datetime',
+        ];
+    }
+}
