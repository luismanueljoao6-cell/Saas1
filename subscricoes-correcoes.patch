  * `Accept: application/vnd.proxypay.v2+json` (NÃO é Bearer).
  * Sandbox: PROXYPAY_BASE_URL=https://api.sandbox.proxypay.co.ao
  *
- * Os webhooks da ProxyPay v2 são autenticados com HMAC-SHA-256 do corpo
- * HTTP original, usando a API key como segredo e a assinatura hexadecimal
- * no cabeçalho X-Signature. Nunca aceitar tokens na query string.
+ * Autenticação dos callbacks (push API). A documentação da ProxyPay envia a
+ * assinatura DENTRO do corpo JSON (`meta.timestamp` + `meta.signature`), com
+ *   signature = HMAC-SHA-256(API key, timestamp + checksum_data)
+ * e o evento aninhado em `payment`. Também se aceita o esquema alternativo
+ * `X-Signature` = HMAC-SHA-256 do corpo bruto. Qualquer dos dois tem de ser
+ * válido, com a API key como segredo. Nunca aceitar tokens na query string.
  */
-class ProxyPayGateway implements GatewayPagamentoInterface
+class ProxyPayGateway implements GatewayCancelavelInterface, GatewayPagamentoInterface
 {
     protected string $baseUrl;
 
@@ -148,26 +152,93 @@ public function validarPedidoWebhook(Request $request): bool
             return false;
         }
 
+        return $this->assinaturaDoCabecalhoValida($request)
+            || $this->assinaturaDoCorpoValida($request);
+    }
+
+    /**
+     * Esquema alternativo: HMAC-SHA-256 hexadecimal dos bytes originais do
+     * corpo (nunca do JSON re-serializado) no cabeçalho X-Signature.
+     */
+    protected function assinaturaDoCabecalhoValida(Request $request): bool
+    {
         $assinatura = strtolower(trim((string) $request->header('X-Signature', '')));
 
         if (! preg_match('/^[a-f0-9]{64}$/', $assinatura)) {
             return false;
         }
 
-        // Importante: assinar os bytes originais, não o JSON descodificado e
-        // novamente serializado, pois espaços/ordem das propriedades alteram o HMAC.
-        $esperada = hash_hmac('sha256', $request->getContent(), $this->apiKey);
+        return hash_equals(hash_hmac('sha256', $request->getContent(), (string) $this->apiKey), $assinatura);
+    }
+
+    /**
+     * Esquema documentado pela ProxyPay: meta.signature =
+     * HMAC-SHA-256(API key, meta.timestamp + checksum_data).
+     */
+    protected function assinaturaDoCorpoValida(Request $request): bool
+    {
+        $dados = $request->json()->all();
+
+        $evento = $dados['payment'] ?? null;
+        $timestamp = $dados['meta']['timestamp'] ?? null;
+        $assinatura = $dados['meta']['signature'] ?? null;
+
+        if (! is_array($evento) || ! is_scalar($timestamp) || ! is_string($assinatura)) {
+            return false;
+        }
+
+        $assinatura = strtolower(trim($assinatura));
+
+        if (! preg_match('/^[a-f0-9]{64}$/', $assinatura)) {
+            return false;
+        }
+
+        $esperada = hash_hmac('sha256', $timestamp.$this->checksumDoEvento($evento), (string) $this->apiKey);
 
         return hash_equals($esperada, $assinatura);
     }
 
+    /**
+     * checksum_data = amount + datetime + entity_id + id + reference_id +
+     * reference_number + terminal_id + terminal_location +
+     * terminal_transaction_id + terminal_type + valores de custom_fields
+     * ordenados pela chave.
+     *
+     * @param  array<string, mixed>  $evento
+     */
+    protected function checksumDoEvento(array $evento): string
+    {
+        $checksum = '';
+
+        foreach ([
+            'amount', 'datetime', 'entity_id', 'id', 'reference_id', 'reference_number',
+            'terminal_id', 'terminal_location', 'terminal_transaction_id', 'terminal_type',
+        ] as $campo) {
+            $valor = $evento[$campo] ?? '';
+            $checksum .= is_scalar($valor) ? (string) $valor : '';
+        }
+
+        $campos = is_array($evento['custom_fields'] ?? null) ? $evento['custom_fields'] : [];
+        ksort($campos);
+
+        foreach ($campos as $valor) {
+            $checksum .= is_scalar($valor) ? (string) $valor : '';
+        }
+
+        return $checksum;
+    }
+
     public function interpretarNotificacao(Request $request): array
     {
-        $payload = $request->json()->all();
+        $corpo = $request->json()->all();
+
+        // O evento vem aninhado em `payment` (push API); aceita-se também o
+        // formato plano.
+        $payload = is_array($corpo['payment'] ?? null) ? $corpo['payment'] : $corpo;
 
         $referencia = $payload['reference_id'] ?? $payload['reference'] ?? null;
 
-        if (! $referencia) {
+        if (! is_scalar($referencia) || (string) $referencia === '') {
             throw GatewayPagamentoException::pagamentoNaoEncontrado('(referência ausente no payload do webhook)');
         }
 
@@ -175,7 +246,7 @@ public function interpretarNotificacao(Request $request): array
             'referencia_externa' => (string) $referencia,
             'estado' => 'confirmado',
             // Valor efetivamente pago: o PagamentoService compara-o com o devido.
-            'valor' => isset($payload['amount']) ? (string) $payload['amount'] : null,
+            'valor' => isset($payload['amount']) && is_scalar($payload['amount']) ? (string) $payload['amount'] : null,
             'payload' => $payload,
         ];
     }
@@ -185,7 +256,7 @@ protected function http(): PendingRequest
         return Http::withHeaders([
             'Authorization' => 'Token '.$this->apiKey,
             'Accept' => 'application/vnd.proxypay.v2+json',
-        ])->asJson()->timeout(10);
+        ])->asJson()->connectTimeout(5)->timeout(10);
     }
 
