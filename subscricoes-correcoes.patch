@@ -0,0 +1,70 @@
+<?php
+
+namespace Modules\Subscricoes\Tests\Feature;
+
+use Illuminate\Http\Request;
+use Modules\Subscricoes\Services\Gateways\ProxyPayGateway;
+use Tests\TestCase;
+
+/**
+ * Formato documentado pela ProxyPay (push API): evento aninhado em `payment`,
+ * assinatura em `meta.signature` = HMAC-SHA-256(API key, timestamp + checksum_data).
+ * O exemplo é o da própria documentação.
+ */
+class ProxyPayCallbackTest extends TestCase
+{
+    private const CHAVE = 'h5a4e6ctej01hn9agh7uggt5n8r29ups';
+
+    private const ASSINATURA = '809427D33F649EDB8A7C123D76E5B426C37DFE6B56C9160509CFCAA01C86F844';
+
+    private function corpo(string $assinatura = self::ASSINATURA, string $montante = '5000.00'): string
+    {
+        return json_encode([
+            'payment' => [
+                'terminal_type' => '01',
+                'terminal_transaction_id' => '00123',
+                'terminal_location' => 'Luanda',
+                'terminal_id' => '00456',
+                'reference_number' => '283749832',
+                'reference_id' => '8uVigNJ7Jj4hvVMdhQ',
+                'id' => '449500352608',
+                'entity_id' => '99999',
+                'datetime' => '2015-05-10T17:43:10Z',
+                'custom_fields' => ['invoice' => '2014/0097', 'customer_name' => 'Acme'],
+                'amount' => $montante,
+            ],
+            'meta' => ['timestamp' => '1428262214', 'signature' => $assinatura],
+        ]);
+    }
+
+    private function pedido(string $corpo): Request
+    {
+        return Request::create('/api/webhooks/proxypay', 'POST', [], [], [], [
+            'CONTENT_TYPE' => 'application/json',
+        ], $corpo);
+    }
+
+    public function test_aceita_assinatura_documentada_no_corpo(): void
+    {
+        config(['subscricoes.gateways.proxypay.api_key' => self::CHAVE]);
+
+        $this->assertTrue((new ProxyPayGateway)->validarPedidoWebhook($this->pedido($this->corpo())));
+    }
+
+    public function test_rejeita_corpo_adulterado_ou_assinatura_errada(): void
+    {
+        config(['subscricoes.gateways.proxypay.api_key' => self::CHAVE]);
+        $gateway = new ProxyPayGateway;
+
+        $this->assertFalse($gateway->validarPedidoWebhook($this->pedido($this->corpo(montante: '1.00'))));
+        $this->assertFalse($gateway->validarPedidoWebhook($this->pedido($this->corpo(str_repeat('0', 64)))));
+    }
+
+    public function test_interpreta_evento_aninhado_em_payment(): void
+    {
+        $notificacao = (new ProxyPayGateway)->interpretarNotificacao($this->pedido($this->corpo()));
+
+        $this->assertSame('8uVigNJ7Jj4hvVMdhQ', $notificacao['referencia_externa']);
+        $this->assertSame('5000.00', $notificacao['valor']);
+    }
+}
-- 
