new file mode 100644
index 0000000..9718bed
--- /dev/null
+++ b/Modules/Subscricoes/app/Services/Fiscal/ComunicaComAgt.php
@@ -0,0 +1,70 @@
+<?php
+
+namespace Modules\Subscricoes\Services\Fiscal;
+
+use Illuminate\Http\Client\PendingRequest;
+use Illuminate\Support\Facades\Config;
+use Illuminate\Support\Facades\Http;
+use RuntimeException;
+
+/**
+ * Peças comuns a todas as chamadas à API de Facturação Electrónica da AGT.
+ * Quem usa este trait tem de ter `protected JwsAssinador $assinador`.
+ */
+trait ComunicaComAgt
+{
+    /**
+     * @return array{softwareInfoDetail: array<string, mixed>, jwsSoftwareSignature: string}
+     */
+    protected function softwareInfo(): array
+    {
+        $software = Config::get('subscricoes.fiscal.agt.software', []);
+
+        $detalhe = [
+            'productId' => (string) ($software['product_id'] ?? ''),
+            'productVersion' => (string) ($software['product_version'] ?? ''),
+            'softwareValidationNumber' => (string) ($software['validation_number'] ?? ''),
+        ];
+
+        if (! empty($software['signature_version'])) {
+            $detalhe['signatureVersion'] = (int) $software['signature_version'];
+        }
+
+        return [
+            'softwareInfoDetail' => $detalhe,
+            'jwsSoftwareSignature' => $this->assinador->assinar($detalhe),
+        ];
+    }
+
+    protected function nifEmissor(): string
+    {
+        $nif = (string) Config::get('subscricoes.fiscal.emissor.nif');
+
+        if ($nif === '') {
+            throw new RuntimeException('Define SUBSCRICOES_EMISSOR_NIF para emitir documentos fiscais.');
+        }
+
+        return $nif;
+    }
+
+    protected function http(): PendingRequest
+    {
+        $agt = Config::get('subscricoes.fiscal.agt', []);
+
+        return Http::withBasicAuth((string) ($agt['username'] ?? ''), (string) ($agt['password'] ?? ''))
+            ->acceptJson()
+            ->asJson()
+            ->connectTimeout(5)
+            ->timeout(30);
+    }
+
+    protected function url(string $servico): string
+    {
+        $base = rtrim((string) Config::get('subscricoes.fiscal.agt.base_url', 'https://sifphml.minfin.gov.ao'), '/');
+        // A documentação da AGT mostra caminhos diferentes entre homologação
+        // (/sigt/fe/ws/v1) e produção (/sigt/fe/v1): configurável.
+        $caminho = '/'.trim((string) Config::get('subscricoes.fiscal.agt.caminho', '/sigt/fe/v1'), '/');
+
+        return "{$base}{$caminho}/{$servico}";
+    }
+}
