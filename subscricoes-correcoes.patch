+++ b/Modules/Subscricoes/tests/Feature/ConformidadeLegalTest.php
@@ -0,0 +1,342 @@
+<?php
+
+namespace Modules\Subscricoes\Tests\Feature;
+
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Validator;
+use Modules\Core\Models\Empresa;
+use Modules\Core\Models\User;
+use Modules\Core\Rules\NifAngolano;
+use Modules\Subscricoes\Jobs\AtualizarEstadoDocumentosFiscaisJob;
+use Modules\Subscricoes\Models\DocumentoFiscal;
+use Modules\Subscricoes\Models\Pagamento;
+use Modules\Subscricoes\Models\Plano;
+use Modules\Subscricoes\Models\Subscricao;
+use Modules\Subscricoes\Services\Fiscal\DocumentoFiscalService;
+use Modules\Subscricoes\Services\Gateways\Contracts\GatewayPagamentoInterface;
+use Modules\Subscricoes\Services\PagamentoService;
+use Modules\Subscricoes\Services\SubscricaoService;
+use Modules\Subscricoes\Support\CalculoIva;
+use Spatie\Permission\Models\Role;
+use Spatie\Permission\PermissionRegistrar;
+use Tests\TestCase;
+
+class GatewayFalsoLegal implements GatewayPagamentoInterface
+{
+    public function identificador(): string
+    {
+        return 'gateway-legal';
+    }
+
+    public function gerarReferencia(Pagamento $pagamento): array
+    {
+        return ['referencia_externa' => 'LEG-'.$pagamento->id, 'payload' => ['entity_id' => '11223']];
+    }
+
+    public function validarPedidoWebhook(Request $request): bool
+    {
+        return true;
+    }
+
+    public function interpretarNotificacao(Request $request): array
+    {
+        return ['referencia_externa' => '', 'estado' => 'confirmado', 'valor' => null, 'payload' => []];
+    }
+}
+
+class ConformidadeLegalTest extends TestCase
+{
+    use RefreshDatabase;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        $this->withoutVite();
+        $this->app->instance(GatewayPagamentoInterface::class, new GatewayFalsoLegal);
+        $this->app->forgetInstance(SubscricaoService::class);
+    }
+
+    /** @return array{0: Empresa, 1: Plano} */
+    protected function cenario(string $nif): array
+    {
+        $empresa = Empresa::create(['nome_comercial' => 'Empresa '.$nif, 'nif' => $nif]);
+        $plano = Plano::create([
+            'nome' => 'Plano '.$nif,
+            'slug' => 'plano-'.$nif,
+            'preco' => 9900,
+            'periodo_dias' => 30,
+        ]);
+
+        return [$empresa->fresh(), $plano];
+    }
+
+    protected function confirmar(Empresa $empresa, Plano $plano): Pagamento
+    {
+        $pagamento = app(SubscricaoService::class)->iniciar($empresa, $plano);
+        app(PagamentoService::class)->confirmar($pagamento, [], null, '9900.00');
+
+        return Pagamento::withoutGlobalScopes()->findOrFail($pagamento->id);
+    }
+
+    /** @return array{0: string, 1: string} [caminho da chave privada, chave pública PEM] */
+    protected function gerarChave(): array
+    {
+        $chave = openssl_pkey_new(['private_key_bits' => 2048, 'private_key_type' => OPENSSL_KEYTYPE_RSA]);
+        openssl_pkey_export($chave, $privada);
+        $publica = openssl_pkey_get_details($chave)['key'];
+
+        $caminho = tempnam(sys_get_temp_dir(), 'agt');
+        file_put_contents($caminho, $privada);
+
+        return [$caminho, $publica];
+    }
+
+    protected function configurarAgt(string $caminhoChave): void
+    {
+        config([
+            'subscricoes.fiscal.driver' => 'agt',
+            'subscricoes.fiscal.serie' => 'FR2026A',
+            'subscricoes.fiscal.emissor.nif' => '5000000000',
+            'subscricoes.fiscal.agt.username' => 'produtor',
+            'subscricoes.fiscal.agt.password' => 'segredo',
+            'subscricoes.fiscal.agt.chave_privada_caminho' => $caminhoChave,
+            'subscricoes.fiscal.agt.software.validation_number' => 'C_999',
+        ]);
+    }
+
+    // ------------------------------------------------------------------ IVA
+
+    public function test_iva_incluido_no_preco_desdobra_sem_alterar_o_total(): void
+    {
+        $iva = CalculoIva::desdobrar('9900', 14, true);
+
+        $this->assertSame('9900.00', $iva['total']);
+        $this->assertSame('8684.21', $iva['base']);
+        $this->assertSame('1215.79', $iva['iva']);
+    }
+
+    public function test_iva_acrescido_ao_preco_base(): void
+    {
+        $iva = CalculoIva::desdobrar('9900', 14, false);
+
+        $this->assertSame('9900.00', $iva['base']);
+        $this->assertSame('1386.00', $iva['iva']);
+        $this->assertSame('11286.00', $iva['total']);
+    }
+
+    public function test_pagamento_guarda_o_desdobramento_do_iva(): void
+    {
+        [$empresa, $plano] = $this->cenario('830000001');
+
+        $pagamento = app(SubscricaoService::class)->iniciar($empresa, $plano);
+        $pagamento = Pagamento::withoutGlobalScopes()->findOrFail($pagamento->id);
+
+        $this->assertSame('9900.00', (string) $pagamento->valor);
+        $this->assertSame('8684.21', (string) $pagamento->valor_base);
+        $this->assertSame('1215.79', (string) $pagamento->valor_iva);
+        $this->assertSame('14.00', (string) $pagamento->taxa_iva);
+    }
+
+    // ---------------------------------------------------- documento fiscal
+
+    public function test_modo_manual_cria_o_documento_pendente_e_o_super_admin_regista_o_numero(): void
+    {
+        [$empresa, $plano] = $this->cenario('830000002');
+        $pagamento = $this->confirmar($empresa, $plano);
+
+        $documento = DocumentoFiscal::withoutGlobalScopes()->where('pagamento_id', $pagamento->id)->firstOrFail();
+        $this->assertSame('pendente', $documento->estado);
+        $this->assertNull($documento->numero_documento);
+
+        $superAdmin = User::factory()->superAdmin()->create();
+
+        $this->actingAs($superAdmin)->get(route('subscricoes.admin.documentos'))->assertOk();
+
+        $this->actingAs($superAdmin)
+            ->post(route('subscricoes.admin.documentos.registar', $documento->id), ['numero_documento' => 'FR 2026/77'])
+            ->assertRedirect();
+
+        $documento->refresh();
+        $this->assertSame('externo', $documento->estado);
+        $this->assertSame('FR 2026/77', $documento->numero_documento);
+    }
+
+    public function test_utilizador_normal_nao_gere_documentos_fiscais(): void
+    {
+        [$empresa, $plano] = $this->cenario('830000003');
+        $this->confirmar($empresa, $plano);
+
+        $normal = User::create([
+            'empresa_id' => $empresa->id,
+            'name' => 'Normal',
+            'email' => 'normal830000003@teste.test',
+            'password' => 'Senha-Forte-123!',
+            'ativo' => true,
+        ]);
+
+        $this->actingAs($normal)->get(route('subscricoes.admin.documentos'))->assertForbidden();
+    }
+
+    public function test_driver_agt_envia_o_documento_com_assinaturas_jws_validas(): void
+    {
+        [$caminho, $publica] = $this->gerarChave();
+        $this->configurarAgt($caminho);
+
+        Http::fake(['*registarFactura' => Http::response(['requestID' => '202600000000001', 'errorList' => []], 200)]);
+
+        [$empresa, $plano] = $this->cenario('5417000001');
+        $pagamento = $this->confirmar($empresa, $plano);
+
+        $documento = DocumentoFiscal::withoutGlobalScopes()->where('pagamento_id', $pagamento->id)->firstOrFail();
+
+        $this->assertSame('enviado', $documento->estado);
+        $this->assertSame('FR FR2026A/1', $documento->numero_documento);
+        $this->assertSame('202600000000001', $documento->request_id);
+
+        Http::assertSent(function ($pedido) use ($publica) {
+            if (! str_contains($pedido->url(), '/sigt/fe/v1/registarFactura')) {
+                return false;
+            }
+
+            $corpo = $pedido->data();
+            $doc = $corpo['documents'][0];
+
+            $totaisOk = $doc['documentTotals'] === ['taxPayable' => 1215.79, 'netTotal' => 8684.21, 'grossTotal' => 9900]
+                && $doc['customerTaxID'] === '5417000001'
+                && $corpo['taxRegistrationNumber'] === '5000000000'
+                && $corpo['softwareInfo']['softwareInfoDetail']['softwareValidationNumber'] === 'C_999';
+
+            return $totaisOk
+                && $this->jwsValida($doc['jwsDocumentSignature'], $publica)
+                && $this->jwsValida($corpo['softwareInfo']['jwsSoftwareSignature'], $publica)
+                && $pedido->hasHeader('Authorization');
+        });
+
+        @unlink($caminho);
+    }
+
+    public function test_estado_da_agt_valida_o_documento(): void
+    {
+        [$caminho] = $this->gerarChave();
+        $this->configurarAgt($caminho);
+
+        Http::fake([
+            '*registarFactura' => Http::response(['requestID' => '202600000000002', 'errorList' => []], 200),
+            '*obterEstado' => Http::response([
+                'requestID' => '202600000000002',
+                'resultCode' => 0,
+                'documentStatusList' => [['documentNo' => 'FR FR2026A/1', 'documentStatus' => 'V']],
+            ], 200),
+        ]);
+
+        [$empresa, $plano] = $this->cenario('5417000002');
+        $pagamento = $this->confirmar($empresa, $plano);
+
+        (new AtualizarEstadoDocumentosFiscaisJob)->handle(
+            app(\Modules\Core\Services\TenantManager::class),
+            app(\Modules\Subscricoes\Contracts\EmissorDocumentoFiscalInterface::class),
+        );
+
+        $documento = DocumentoFiscal::withoutGlobalScopes()->where('pagamento_id', $pagamento->id)->firstOrFail();
+        $this->assertSame('validado', $documento->estado);
+        $this->assertNotNull($documento->validado_em);
+
+        @unlink($caminho);
+    }
+
+    public function test_rejeicao_da_agt_pede_novo_numero_com_referencia_ao_rejeitado(): void
+    {
+        [$caminho] = $this->gerarChave();
+        $this->configurarAgt($caminho);
+
+        Http::fake(['*registarFactura' => Http::sequence()
+            ->push(['errorList' => [['idError' => 'E10', 'descriptionError' => 'NIF desconhecido']]], 400)
+            ->push(['requestID' => '202600000000003', 'errorList' => []], 200)]);
+
+        [$empresa, $plano] = $this->cenario('5417000003');
+        $pagamento = $this->confirmar($empresa, $plano);
+
+        $documento = DocumentoFiscal::withoutGlobalScopes()->where('pagamento_id', $pagamento->id)->firstOrFail();
+        $this->assertSame('rejeitado', $documento->estado);
+        $this->assertStringContainsString('E10', (string) $documento->erro);
+
+        app(DocumentoFiscalService::class)->reemitir($documento);
+
+        \Modules\Subscricoes\Jobs\EmitirDocumentoFiscalJob::dispatch($pagamento->id);
+
+        $documento->refresh();
+        $this->assertSame('enviado', $documento->estado);
+        $this->assertSame('FR FR2026A/2', $documento->numero_documento);
+
+        Http::assertSent(fn ($p) => str_contains($p->url(), 'registarFactura')
+            && ($p->data()['documents'][0]['rejectedDocumentNo'] ?? null) === 'FR FR2026A/1'
+            && $p->data()['documents'][0]['documentStatus'] === 'C');
+
+        @unlink($caminho);
+    }
+
+    protected function jwsValida(string $jws, string $publica): bool
+    {
+        [$cabecalho, $corpo, $assinatura] = explode('.', $jws);
+
+        $decodificar = fn (string $v) => base64_decode(strtr($v, '-_', '+/'));
+
+        return openssl_verify("{$cabecalho}.{$corpo}", $decodificar($assinatura), $publica, OPENSSL_ALGO_SHA256) === 1
+            && json_decode($decodificar($cabecalho), true) === ['alg' => 'RS256', 'typ' => 'JWT'];
+    }
+
+    // ------------------------------------------- condições, termos e NIF
+
+    public function test_subscricao_exige_aceitar_as_condicoes_e_guarda_a_prova(): void
+    {
+        [$empresa, $plano] = $this->cenario('830000004');
+
+        $admin = User::create([
+            'empresa_id' => $empresa->id,
+            'name' => 'Admin',
+            'email' => 'admin830000004@teste.test',
+            'password' => 'Senha-Forte-123!',
+            'ativo' => true,
+        ]);
+        app(PermissionRegistrar::class)->setPermissionsTeamId($empresa->id);
+        $admin->assignRole(Role::firstOrCreate(['name' => 'Administrador', 'guard_name' => 'web', 'empresa_id' => $empresa->id]));
+
+        $this->actingAs($admin)
+            ->post(route('subscricoes.iniciar'), ['plano_id' => $plano->id])
+            ->assertSessionHasErrors('aceita_condicoes');
+        $this->assertSame(0, Subscricao::withoutGlobalScopes()->count());
+
+        $this->actingAs($admin)
+            ->post(route('subscricoes.iniciar'), ['plano_id' => $plano->id, 'aceita_condicoes' => '1'])
+            ->assertRedirect();
+
+        $subscricao = Subscricao::withoutGlobalScopes()->firstOrFail();
+        $this->assertNotNull($subscricao->condicoes_aceites_em);
+        $this->assertSame((string) config('core.legal.versao_termos'), $subscricao->termos_versao);
+    }
+
+    public function test_paginas_legais_sao_publicas(): void
+    {
+        $this->get(route('core.termos'))->assertOk()->assertSee('Termos de utilização');
+        $this->get(route('core.privacidade'))->assertOk()->assertSee('Lei n.º 22/11');
+    }
+
+    public function test_regra_do_nif_angolano(): void
+    {
+        $passa = fn (string $nif) => ! Validator::make(['nif' => $nif], ['nif' => [new NifAngolano]])->fails();
+
+        $this->assertTrue($passa('5417000001'));       // 10 dígitos (empresa)
+        $this->assertTrue($passa('000123456LA041'));   // BI
+        $this->assertTrue($passa('500000123'));        // 9 dígitos: aceite por omissão
+        $this->assertFalse($passa('50000012'));        // curto
+        $this->assertFalse($passa('ABCDEFGHIJ'));
+        $this->assertFalse($passa('500 000 123'));
+
+        config(['core.nif_estrito' => true]);
+        $this->assertFalse($passa('500000123'));       // 9 dígitos já não passa em modo estrito
+        $this->assertTrue($passa('5417000001'));
+    }
+}
diff --git a/README.md b/README.md
index 7426ceb..5eb9e68 100644
--- a/README.md
+++ b/README.md
@@ -21,14 +21,85 @@ ## Estado atual
 GitHub Codespace — registo de empresa, login, criação e emissão de
 faturas, subscrição a um plano, e exportação SAF-T processada em fila.
 
-## ⚠️ Conformidade AGT — ler antes de qualquer uso real
-
-O módulo de Faturação implementa a numeração sequencial, a cadeia de
-assinatura RSA e a imutabilidade de documentos exigidas pela AGT, mas isto
-**não substitui a certificação do software junto da AGT**, obrigatória
-para faturação eletrónica real em Angola desde janeiro de 2026 (grandes
-contribuintes) e a alargar a todas as empresas em 2027. Detalhes completos
-em `Modules/Faturacao/README.md`.
+## ⚠️ Conformidade legal (Angola) — estado e pendências
+
+> **Este software NÃO está certificado pela AGT.** O que está implementado
+> prepara o terreno, mas não substitui a certificação, o contabilista nem o
+> advogado. Revisão feita em outubro de 2026 com base em fontes públicas (lista
+> no fim desta secção); a lei muda — confirma sempre na AGT.
+
+### Enquadramento (resumo)
+
+- **Faturas:** Decreto Presidencial 71/25 (20/03/2025) substituiu o regime de 2018
+  (292/18): faturação **eletrónica** em software **validado pela AGT**, com
+  transmissão em tempo real; o Decreto Executivo 683/25 (22/08/2025) define a
+  estrutura de dados. Obrigatória desde 1/1/2026 para grandes contribuintes e
+  fornecedores do Estado; para os restantes dos regimes Geral e Simplificado as
+  fontes divergem (21/09/2026 vs. 31/12/2026–1/1/2027) — **confirmar a data exata
+  com a AGT**.
+- **IVA:** taxa geral de 14%; SaaS/serviços digitais são tributáveis.
+- **Dados pessoais:** Lei 22/11 (consentimento expresso; notificação à APD;
+  transferência internacional sujeita a notificação/autorização).
+- **Consumidor:** Lei 15/03 (informação clara sobre preço e condições; contratos
+  de adesão). Não encontrei regra angolana específica sobre renovação
+  automática; a boa prática é informar antes, pedir aceitação explícita e
+  permitir cancelar facilmente (implementado abaixo).
+
+### Já implementado
+
+| Requisito | Onde | Nota |
+|---|---|---|
+| IVA desdobrado (base / IVA / total) em cada pagamento | `Subscricoes` (`CalculoIva`, colunas `valor_base/valor_iva/taxa_iva`) | Por omissão o preço do plano **já inclui IVA** (`SUBSCRICOES_PRECO_INCLUI_IVA`) |
+| Documento fiscal por pagamento confirmado | `Subscricoes` (`documentos_fiscais`, jobs, `/admin/documentos-fiscais`) | Modo `manual` (omissão) ou `agt` |
+| Cliente da API de Facturação Electrónica da AGT (schema 2.0): `registarFactura`, `obterEstado`, JWS RS256, séries sem reutilização de números, rejeição → reemissão (`documentStatus=C`) | `Subscricoes\Services\Fiscal` | Testado só com HTTP simulado; **nunca contra a AGT** |
+| Condições de subscrição aceites de forma explícita (preço, período, renovação) com prova (data + versão) | `Subscricoes` | Sem cobrança automática: o cliente recebe nova referência e paga se quiser |
+| Consentimento no registo com prova (data + versão dos termos) | `Core` (`empresas.termos_*`) | |
+| Páginas `/termos` e `/privacidade` | `Core` | **Rascunho** — ver pendências |
+| Validação do formato do NIF (10 dígitos, BI de 14 caracteres; 9 dígitos antigos só se `CORE_NIF_ESTRITO=false`) | `Core\Rules\NifAngolano` | Valida o formato, **não** a existência na AGT |
+| Webhooks de pagamento autenticados (HMAC) e auditados | `Subscricoes` (`eventos_webhook`) | Confirmar formato v2 no sandbox ProxyPay |
+| Faturas imutáveis, numeração sem lacunas, anulação por nota de crédito | `Faturacao` | Regime **antigo** (ver pendências) |
+
+### O que ainda falta (não se resolve só com código)
+
+1. **Certificação do software junto da AGT** (obtém o `softwareValidationNumber`).
+   Sem ela, nenhuma fatura emitida por este software tem validade fiscal.
+   Credenciais da API: pedido por e-mail a `produtores.dfe.dcrr.agt@minfin.gov.ao`
+   (nome e NIF da empresa), segundo a documentação da AGT.
+2. **Ativar o driver `agt` só depois de:** credenciais AGT, chave RSA ≥ 2048 bits
+   registada, **série criada na AGT** (`solicitarSerie` — ainda **não
+   implementado** aqui, `listarSeries`/`estenderSerie` idem) e testes no
+   ambiente de homologação (`https://sifphml.minfin.gov.ao`).
+3. **Módulo `Faturacao` (faturas das empresas clientes) ainda segue o regime
+   antigo** (assinatura RSA-SHA1, SAF-T provisório sem validação XSD). Falta
+   migrá-lo para o Decreto Executivo 683/25: comunicação em tempo real à AGT
+   (reutilizar `JwsAssinador`/`EmissorAgt` como base), validação do NIF do
+   cliente (desde 1/1/2026 os documentos têm de referir um NIF existente; o
+   NIF `999999999` só serve consumidor final), anulação via `anularFactura`,
+   faturas de **contingência** (offline), **QR Code** conforme a especificação
+   da AGT, e comunicação em ≤ 24 h (há penalização por atraso).
+4. **Consulta online do NIF** (SIFP/AGT): não implementada; só se valida o formato.
+5. **Dados pessoais (Lei 22/11):** notificar/registar os tratamentos na **APD**;
+   se o servidor ou algum subcontratante (e-mail, cloud) estiver fora de Angola,
+   notificar/pedir autorização da transferência internacional (a APD já multou
+   por isto); definir prazos de conservação e um processo para pedidos de acesso,
+   retificação e eliminação (hoje é manual) e para incidentes de segurança.
+6. **Textos legais:** `/termos` e `/privacidade` são modelos em rascunho com
+   campos a preencher (`CORE_ENTIDADE_*`). Têm de ser revistos por um advogado
+   (limitação de responsabilidade, lei aplicável e foro, subcontratantes,
+   prazos). Depois, `CORE_LEGAL_AVISO_RASCUNHO=false`.
+7. **IVA:** confirmar com um contabilista o enquadramento (regime, taxa, se os
+   preços de catálogo incluem IVA) e a declaração periódica — fora do âmbito
+   desta aplicação.
+8. **Renovação:** o aviso é enviado `SUBSCRICOES_AVISO_RENOVACAO_DIAS` (3) dias
+   antes. Se o aconselhamento jurídico pedir mais antecedência, aumenta-o (e a
+   validade da referência).
+
+### Fontes consultadas
+
+- AGT — documentação oficial de Facturação Electrónica (API v2): <https://quiosqueagt.minfin.gov.ao/doc-agt/doc-agt/2/index.html>
+- Decreto Presidencial 71/25 e Decreto Executivo 683/25 (resumos: EY Angola, Cegid, Expansão)
+- Lei 22/11 (Protecção de Dados Pessoais) e Lei 15/03 (Defesa do Consumidor), texto em angolex.com / lex.ao
+- Calendário da faturação eletrónica: Cegid, Líder Magazine, mercado.co.ao (datas divergentes entre fontes)
 
