+    protected function ativarSubscricao(Empresa $empresa, Plano $plano): Subscricao
+    {
+        $pagamento = app(SubscricaoService::class)->iniciar($empresa, $plano);
+        app(PagamentoService::class)->confirmar($pagamento, [], null, '9900.00');
+
+        return Subscricao::withoutGlobalScopes()->where('empresa_id', $empresa->id)->firstOrFail();
+    }
