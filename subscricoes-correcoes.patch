diff --git a/Modules/Subscricoes/app/Services/Fiscal/DocumentoFiscalService.php b/Modules/Subscricoes/app/Services/Fiscal/DocumentoFiscalService.php
new file mode 100644
index 0000000..f9bac2e
--- /dev/null
+++ b/Modules/Subscricoes/app/Services/Fiscal/DocumentoFiscalService.php
@@ -0,0 +1,123 @@
+<?php
+
+namespace Modules\Subscricoes\Services\Fiscal;
+
+use DomainException;
+use Illuminate\Support\Facades\Config;
+use Illuminate\Support\Facades\DB;
+use Modules\Subscricoes\Enums\DocumentoFiscalEstado;
+use Modules\Subscricoes\Models\DocumentoFiscal;
+use Modules\Subscricoes\Models\Pagamento;
+
+/**
+ * Ciclo de vida do documento fiscal de uma subscrição. Chamar sempre fora do
+ * contexto de um tenant (TenantManager::semTenant) quando executado por jobs.
+ */
+class DocumentoFiscalService
+{
+    public function criarParaPagamento(Pagamento $pagamento): DocumentoFiscal
+    {
+        return DocumentoFiscal::withoutGlobalScopes()->firstOrCreate(
+            ['pagamento_id' => $pagamento->id],
+            [
+                'empresa_id' => $pagamento->empresa_id,
+                'tipo' => (string) Config::get('subscricoes.fiscal.tipo_documento', 'FR'),
+                'serie' => Config::get('subscricoes.fiscal.serie'),
+                'estado' => DocumentoFiscalEstado::Pendente->value,
+            ],
+        );
+    }
+
+    /**
+     * Atribui o próximo número da série a partir de um contador com bloqueio
+     * de linha: sem repetições, mesmo depois de rejeições (unique serie+numero
+     * na BD é a segunda barreira).
+     */
+    public function atribuirNumero(DocumentoFiscal $documento): DocumentoFiscal
+    {
+        if ($documento->numero !== null) {
+            return $documento;
+        }
+
+        $serie = (string) ($documento->serie ?: Config::get('subscricoes.fiscal.serie'));
+
+        if ($serie === '') {
+            throw new DomainException('Define SUBSCRICOES_FISCAL_SERIE (série criada na AGT) para numerar documentos.');
+        }
+
+        return DB::transaction(function () use ($documento, $serie) {
+            $linha = DB::table('series_fiscais')->where('serie', $serie)->lockForUpdate()->first();
+
+            if (! $linha) {
+                DB::table('series_fiscais')->insertOrIgnore([
+                    'serie' => $serie,
+                    'ultimo_numero' => 0,
+                    'created_at' => now(),
+                    'updated_at' => now(),
+                ]);
+
+                $linha = DB::table('series_fiscais')->where('serie', $serie)->lockForUpdate()->first();
+            }
+
+            $numero = ((int) $linha->ultimo_numero) + 1;
+
+            DB::table('series_fiscais')->where('id', $linha->id)->update([
+                'ultimo_numero' => $numero,
+                'updated_at' => now(),
+            ]);
+
+            $documento->forceFill([
+                'serie' => $serie,
+                'numero' => $numero,
+                // Formato da AGT: "<tipo> <série>/<número>" (ex.: "FR FR6325S2C/10006").
+                'numero_documento' => "{$documento->tipo} {$serie}/{$numero}",
+                'emitido_em' => now(),
+            ])->save();
+
+            return $documento;
+        });
+    }
+
+    /**
+     * Regista o número de um documento emitido noutro software certificado.
+     */
+    public function registarExterno(DocumentoFiscal $documento, string $numeroDocumento): DocumentoFiscal
+    {
+        $numeroDocumento = trim($numeroDocumento);
+
+        if ($numeroDocumento === '' || mb_strlen($numeroDocumento) > 60) {
+            throw new DomainException('Indica o número do documento (até 60 caracteres).');
+        }
+
+        $documento->forceFill([
+            'numero_documento' => $numeroDocumento,
+            'estado' => DocumentoFiscalEstado::Externo->value,
+            'emitido_em' => $documento->emitido_em ?? now(),
+            'erro' => null,
+        ])->save();
+
+        return $documento;
+    }
+
+    /**
+     * Uma rejeição da AGT não se corrige reenviando o mesmo número (erro E46):
+     * emite-se um novo número que referencia o rejeitado (documentStatus "C").
+     */
+    public function reemitir(DocumentoFiscal $documento): DocumentoFiscal
+    {
+        if ($documento->estado !== DocumentoFiscalEstado::Rejeitado->value) {
+            throw new DomainException('Só se reemitem documentos rejeitados pela AGT.');
+        }
+
+        $documento->forceFill([
+            'rejeitado_no' => $documento->numero_documento,
+            'numero' => null,
+            'numero_documento' => null,
+            'request_id' => null,
+            'estado' => DocumentoFiscalEstado::Pendente->value,
+            'erro' => null,
+        ])->save();
+
+        return $documento;
+    }
+}
diff --git a/Modules/Subscricoes/app/Services/Fiscal/EmissorAgt.php b/Modules/Subscricoes/app/Services/Fiscal/EmissorAgt.php
new file mode 100644
index 0000000..b8c0205
--- /dev/null
+++ b/Modules/Subscricoes/app/Services/Fiscal/EmissorAgt.php
@@ -0,0 +1,295 @@
+<?php
+
+namespace Modules\Subscricoes\Services\Fiscal;
+
+use Illuminate\Http\Client\PendingRequest;
+use Illuminate\Support\Facades\Config;
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Str;
+use Modules\Subscricoes\Contracts\EmissorDocumentoFiscalInterface;
+use Modules\Subscricoes\Enums\DocumentoFiscalEstado;
+use Modules\Subscricoes\Models\DocumentoFiscal;
+use RuntimeException;
+
+/**
+ * Cliente da API REST de Facturação Electrónica da AGT (schema 2.0), segundo a
+ * documentação oficial: https://quiosqueagt.minfin.gov.ao/doc-agt/doc-agt/2/index.html
+ *
+ *  - Basic Auth com credenciais emitidas pela AGT ao produtor de software;
+ *  - registarFactura: envio síncrono, resposta com requestID; a validação é
+ *    diferida e consultada com obterEstado;
+ *  - assinaturas JWS RS256 do software, do documento e do pedido.
+ *
+ * IMPORTANTE: só tem validade fiscal se o SOFTWARE estiver certificado pela
+ * AGT (softwareValidationNumber real) e a série tiver sido criada na AGT
+ * (solicitarSerie). Sem isso a AGT rejeita (erros E07/E08/E09...). Por isso o
+ * driver por omissão é 'manual'. Testa primeiro no ambiente de homologação
+ * (sifphml.minfin.gov.ao).
+ */
+class EmissorAgt implements EmissorDocumentoFiscalInterface
+{
+    public function __construct(protected JwsAssinador $assinador) {}
+
+    public function emitir(DocumentoFiscal $documento): void
+    {
+        $documento->loadMissing(['pagamento.subscricao.plano', 'empresa']);
+
+        $payload = $this->construirRegisto($documento);
+
+        $resposta = $this->http()->post($this->url('registarFactura'), $payload);
+
+        $documento->tentativas++;
+        $documento->payload = $payload;
+        $documento->resposta = $resposta->json() ?? ['corpo' => $resposta->body()];
+
+        // 400 = pedido recusado com lista de erros: não adianta repetir igual.
+        if ($resposta->status() === 400) {
+            $documento->estado = DocumentoFiscalEstado::Rejeitado->value;
+            $documento->erro = $this->resumirErros($resposta->json('errorList'));
+            $documento->save();
+
+            return;
+        }
+
+        if (! $resposta->successful()) {
+            $documento->estado = DocumentoFiscalEstado::Erro->value;
+            $documento->erro = "AGT respondeu HTTP {$resposta->status()}";
+            $documento->save();
+
+            throw new RuntimeException($documento->erro);
+        }
+
+        $erros = $resposta->json('errorList') ?? [];
+
+        if (! empty($erros)) {
+            $documento->estado = DocumentoFiscalEstado::Rejeitado->value;
+            $documento->erro = $this->resumirErros($erros);
+            $documento->save();
+
+            return;
+        }
+
+        $documento->estado = DocumentoFiscalEstado::Enviado->value;
+        $documento->request_id = (string) $resposta->json('requestID');
+        $documento->erro = null;
+        $documento->enviado_em = now();
+        $documento->save();
+    }
+
+    public function atualizarEstado(DocumentoFiscal $documento): void
+    {
+        if ($documento->estado !== DocumentoFiscalEstado::Enviado->value || ! $documento->request_id) {
+            return;
+        }
+
+        $nif = $this->nifEmissor();
+
+        $payload = [
+            'schemaVersion' => '2.0',
+            'taxRegistrationNumber' => $nif,
+            'submissionTimeStamp' => now()->utc()->format('Y-m-d\TH:i:s\Z'),
+            'softwareInfo' => $this->softwareInfo(),
+            'jwsSignature' => $this->assinador->assinar([
+                'taxRegistrationNumber' => $nif,
+                'requestID' => $documento->request_id,
+            ]),
+            'requestID' => $documento->request_id,
+        ];
+
+        $resposta = $this->http()->post($this->url('obterEstado'), $payload);
+
+        // 422 com E96/E97 = ainda em processamento / pedido prematuro; 429 = demasiado cedo.
+        if (in_array($resposta->status(), [422, 429], true)) {
+            return;
+        }
+
+        if (! $resposta->successful()) {
+            throw new RuntimeException("AGT (obterEstado) respondeu HTTP {$resposta->status()}");
+        }
+
+        $dados = $resposta->json() ?? [];
+        $codigo = (int) ($dados['resultCode'] ?? 8);
+
+        // 7 = prematuro/repetido, 8 = em curso: voltar a tentar mais tarde.
+        if (in_array($codigo, [7, 8], true)) {
+            return;
+        }
+
+        $documento->resposta = $dados;
+
+        if ($codigo === 9) {
+            $documento->estado = DocumentoFiscalEstado::Erro->value;
+            $documento->erro = 'Processamento cancelado pela AGT.';
+            $documento->save();
+
+            return;
+        }
+
+        $estadoDoc = collect($dados['documentStatusList'] ?? [])
+            ->firstWhere('documentNo', $documento->numero_documento);
+
+        if (($estadoDoc['documentStatus'] ?? null) === 'V' || ($codigo === 0 && $estadoDoc === null)) {
+            $documento->estado = DocumentoFiscalEstado::Validado->value;
+            $documento->validado_em = now();
+            $documento->erro = null;
+        } else {
+            $documento->estado = DocumentoFiscalEstado::Rejeitado->value;
+            $documento->erro = $this->resumirErros($estadoDoc['errorList'] ?? []);
+        }
+
+        $documento->save();
+    }
+
+    /**
+     * @return array<string, mixed>
+     */
+    public function construirRegisto(DocumentoFiscal $documento): array
+    {
+        $pagamento = $documento->pagamento;
+        $plano = $pagamento->subscricao->plano;
+        $empresa = $documento->empresa;
+
+        $base = $this->numero($pagamento->valor_base ?? $pagamento->valor);
+        $iva = $this->numero($pagamento->valor_iva ?? '0');
+        $total = $this->numero($pagamento->valor);
+        $taxa = $this->numero($pagamento->taxa_iva ?? '0');
+
+        $dataDocumento = ($documento->emitido_em ?? now())->format('Y-m-d');
+
+        $totais = ['taxPayable' => $iva, 'netTotal' => $base, 'grossTotal' => $total];
+        $nif = $this->nifEmissor();
+
+        $tipoImposto = $iva > 0
+            ? ['taxType' => 'IVA', 'taxCountryRegion' => 'AO', 'taxCode' => 'NOR', 'taxPercentage' => $taxa, 'taxContribution' => $iva]
+            : ['taxType' => 'IVA', 'taxCountryRegion' => 'AO', 'taxCode' => 'ISE', 'taxPercentage' => 0, 'taxContribution' => 0, 'taxExemptionCode' => (string) Config::get('subscricoes.fiscal.codigo_isencao', 'M99')];
+
+        $documentoPayload = [
+            'documentNo' => $documento->numero_documento,
+            'documentStatus' => $documento->rejeitado_no ? 'C' : 'N',
+            'jwsDocumentSignature' => $this->assinador->assinar([
+                'documentNo' => $documento->numero_documento,
+                'taxRegistrationNumber' => $nif,
+                'documentType' => $documento->tipo,
+                'documentDate' => $dataDocumento,
+                'customerTaxID' => (string) $empresa->nif,
+                'customerCountry' => 'AO',
+                'companyName' => (string) $empresa->nome_comercial,
+                'documentTotals' => $totais,
+            ]),
+            'documentDate' => $dataDocumento,
+            'documentType' => $documento->tipo,
+            'systemEntryDate' => ($documento->emitido_em ?? now())->utc()->format('Y-m-d\TH:i:s'),
+            'customerTaxID' => (string) $empresa->nif,
+            'customerCountry' => 'AO',
+            'companyName' => (string) $empresa->nome_comercial,
+            'lines' => [[
+                'lineNumber' => 1,
+                'operationType' => 'SG',
+                'productCode' => Str::limit('SUBSC-'.$plano->slug, 60, ''),
+                'productDescription' => Str::limit("Subscrição {$plano->nome} ({$plano->periodo_dias} dias)", 200, ''),
+                'quantity' => 1,
+                'unitOfMeasure' => 'UN',
+                'unitPriceBase' => $base,
+                'unitPrice' => $base,
+                'creditAmount' => $base,
+                'taxes' => [$tipoImposto],
+                'settlementAmount' => 0,
+            ]],
+            'documentTotals' => $totais,
+        ];
+
+        if ($documento->rejeitado_no) {
+            $documentoPayload['rejectedDocumentNo'] = $documento->rejeitado_no;
+        }
+
+        if ($codigo = Config::get('subscricoes.fiscal.agt.codigo_atividade')) {
+            $documentoPayload['eacCode'] = (string) $codigo;
+        }
+
+        return [
+            'schemaVersion' => '2.0',
+            'submissionUUID' => (string) Str::uuid(),
+            'taxRegistrationNumber' => $nif,
+            'submissionTimeStamp' => now()->utc()->format('Y-m-d\TH:i:s\Z'),
+            'softwareInfo' => $this->softwareInfo(),
+            'numberOfEntries' => 1,
+            'documents' => [$documentoPayload],
+        ];
+    }
+
+    /**
+     * @return array{softwareInfoDetail: array<string, mixed>, jwsSoftwareSignature: string}
+     */
+    protected function softwareInfo(): array
+    {
+        $software = Config::get('subscricoes.fiscal.agt.software', []);
+
+        $detalhe = [
+            'productId' => (string) ($software['product_id'] ?? ''),
+            'productVersion' => (string) ($software['product_version'] ?? ''),
+            'softwareValidationNumber' => (string) ($software['validation_number'] ?? ''),
+        ];
+
+        if (! empty($software['signature_version'])) {
+            $detalhe['signatureVersion'] = (int) $software['signature_version'];
+        }
+
+        return [
+            'softwareInfoDetail' => $detalhe,
+            'jwsSoftwareSignature' => $this->assinador->assinar($detalhe),
+        ];
+    }
+
+    protected function nifEmissor(): string
+    {
+        $nif = (string) Config::get('subscricoes.fiscal.emissor.nif');
+
+        if ($nif === '') {
+            throw new RuntimeException('Define SUBSCRICOES_EMISSOR_NIF para emitir documentos fiscais.');
+        }
+
+        return $nif;
+    }
+
+    protected function http(): PendingRequest
+    {
+        $agt = Config::get('subscricoes.fiscal.agt', []);
+
+        return Http::withBasicAuth((string) ($agt['username'] ?? ''), (string) ($agt['password'] ?? ''))
+            ->acceptJson()
+            ->asJson()
+            ->connectTimeout(5)
+            ->timeout(30);
+    }
+
+    protected function url(string $servico): string
+    {
+        $base = rtrim((string) Config::get('subscricoes.fiscal.agt.base_url', 'https://sifphml.minfin.gov.ao'), '/');
+
+        return "{$base}/sigt/fe/v1/{$servico}";
+    }
+
+    /**
+     * Números JSON "sem formatação adicional": inteiros quando redondos.
+     */
+    protected function numero(string|float|int|null $valor): int|float
+    {
+        $f = round((float) $valor, 2);
+
+        return floor($f) === $f ? (int) $f : $f;
+    }
+
+    /**
+     * @param  array<int, array<string, mixed>>|null  $erros
+     */
+    protected function resumirErros(?array $erros): string
+    {
+        if (empty($erros)) {
+            return 'Rejeitado pela AGT (sem detalhe).';
+        }
+
+        return collect($erros)
+            ->map(fn ($e) => trim(($e['idError'] ?? $e['errorCode'] ?? '?').': '.($e['descriptionError'] ?? $e['errorDescription'] ?? '')))
+            ->implode(' | ');
+    }
+}
