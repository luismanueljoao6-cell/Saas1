+<?php
+
+namespace Modules\Subscricoes\Enums;
+
+/**
+ * Estados de uma Subscricao. A coluna continua a ser string: os models não
+ * fazem cast, por isso `$subscricao->estado` devolve a string e o enum serve
+ * para queries e comparações (`SubscricaoEstado::Ativa->value`) sem strings
+ * soltas espalhadas pelo código.
+ */
+enum SubscricaoEstado: string
+{
+    case Pendente = 'pendente';
+    case Ativa = 'ativa';
+    case Cancelada = 'cancelada';
+    case Expirada = 'expirada';
+
+    public function e(?string $estado): bool
+    {
+        return $estado === $this->value;
+    }
+}
