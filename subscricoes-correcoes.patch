+        $this->actingAs($normal)->get(route('subscricoes.admin.pagamentos'))->assertForbidden();
+        $this->actingAs($normal)->post(route('subscricoes.admin.confirmar', $pagamento->id))->assertForbidden();
+
+        $this->assertSame('pendente', Pagamento::withoutGlobalScopes()->find($pagamento->id)->estado);
