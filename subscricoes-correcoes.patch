diff --git a/Modules/Core/app/Rules/NifAngolano.php b/Modules/Core/app/Rules/NifAngolano.php
new file mode 100644
index 0000000..80d02ca
--- /dev/null
+++ b/Modules/Core/app/Rules/NifAngolano.php
@@ -0,0 +1,35 @@
+<?php
+
+namespace Modules\Core\Rules;
+
+use Closure;
+use Illuminate\Contracts\Validation\ValidationRule;
+
+/**
+ * Valida o FORMATO do NIF angolano. Não confirma que o NIF existe na AGT
+ * (isso exige a consulta online ao SIFP — ver README, "Pendências legais").
+ *
+ * Formatos aceites:
+ *  - pessoa coletiva: 10 dígitos;
+ *  - pessoa singular: número do BI/cartão de residente (9 dígitos + 2 letras + 3 dígitos);
+ *  - NIF antigo de 9 dígitos, SÓ enquanto `core.nif_estrito` for false.
+ *
+ * Com `core.nif_estrito` = true (CORE_NIF_ESTRITO=true), os NIFs de 9 dígitos
+ * deixam de ser aceites.
+ */
+class NifAngolano implements ValidationRule
+{
+    public function validate(string $attribute, mixed $value, Closure $fail): void
+    {
+        // Sem remover espaços: "500 000 123" continua a ser rejeitado.
+        $nif = strtoupper((string) $value);
+
+        $valido = preg_match('/^\d{10}$/', $nif) === 1
+            || preg_match('/^\d{9}[A-Z]{2}\d{3}$/', $nif) === 1
+            || (! config('core.nif_estrito', false) && preg_match('/^\d{9}$/', $nif) === 1);
+
+        if (! $valido) {
+            $fail('NIF inválido: indica os 10 dígitos do NIF da empresa ou o número do BI (14 caracteres).');
+        }
+    }
+}
