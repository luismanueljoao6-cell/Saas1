+<?php
+
+namespace Modules\Subscricoes\Http\Controllers;
+
+use Illuminate\Routing\Controller;
+use Illuminate\View\View;
+use Modules\Subscricoes\Enums\PagamentoEstado;
+use Modules\Subscricoes\Enums\SubscricaoEstado;
+use Modules\Subscricoes\Models\Pagamento;
+use Modules\Subscricoes\Models\Subscricao;
+
+/**
+ * Páginas da própria empresa sobre a sua faturação no SaaS. Os models são
+ * filtrados pelo tenant (BelongsToTenant), por isso cada empresa só vê o seu.
+ */
+class FaturacaoController extends Controller
+{
+    /**
+     * Resumo: subscrição atual, próxima renovação e últimos pagamentos.
+     */
+    public function resumo(): View
+    {
+        $subscricao = Subscricao::with('plano')
+            ->where('estado', SubscricaoEstado::Ativa->value)
+            ->where(fn ($query) => $query->whereNull('termina_em')->orWhere('termina_em', '>', now()))
+            ->latest('id')
+            ->first();
+
+        $pendente = Pagamento::with('subscricao.plano')
+            ->where('estado', PagamentoEstado::Pendente->value)
+            ->where('expira_em', '>', now())
+            ->latest('id')
+            ->first();
+
+        $totalPago = Pagamento::where('estado', PagamentoEstado::Confirmado->value)->sum('valor');
+
+        return view('subscricoes::faturacao.resumo', [
+            'subscricao' => $subscricao,
+            'pendente' => $pendente,
+            'totalPago' => $totalPago,
+            'recentes' => Pagamento::with('subscricao.plano')->latest('id')->limit(5)->get(),
+        ]);
+    }
+
+    /**
+     * Histórico completo de pagamentos da empresa.
+     */
+    public function pagamentos(): View
+    {
+        return view('subscricoes::faturacao.pagamentos', [
+            'pagamentos' => Pagamento::with('subscricao.plano')->latest('id')->paginate(15),
+        ]);
+    }
+}
