+
+    public function test_utilizador_normal_nao_acede_a_reconciliacao_manual(): void
+    {
+        [$empresa, $plano] = $this->cenario('820000007');
+        $pagamento = app(SubscricaoService::class)->iniciar($empresa, $plano);
+        $normal = $this->utilizador($empresa, '820000007');
