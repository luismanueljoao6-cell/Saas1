index 0000000..f633719
--- /dev/null
+++ b/Modules/Subscricoes/app/Support/CalculoIva.php
@@ -0,0 +1,52 @@
+<?php
+
+namespace Modules\Subscricoes\Support;
+
+/**
+ * Desdobra um preço em base tributável, IVA e total, em cêntimos inteiros
+ * (nunca com floats acumulados). Regra de arredondamento do IVA alinhada com a
+ * especificação da AGT: o imposto arredonda-se por excesso ao cêntimo seguinte.
+ *
+ * Com $precoInclui = true (omissão), o preço de catálogo JÁ INCLUI IVA: o total
+ * cobrado é o próprio preço e a base é o que sobra depois de retirar o IVA.
+ * Com false, o preço de catálogo é a base e o IVA acresce ao total.
+ */
+final class CalculoIva
+{
+    /**
+     * @return array{base: string, iva: string, total: string, taxa: string}
+     */
+    public static function desdobrar(string|float|int $preco, float $taxa, bool $precoInclui = true): array
+    {
+        $precoCentimos = (int) round(((float) $preco) * 100);
+
+        if ($taxa <= 0.0) {
+            return self::formatar($precoCentimos, 0, $taxa);
+        }
+
+        if ($precoInclui) {
+            // Pode haver 1 cêntimo de diferença para a taxa exata: o IVA é o
+            // que falta para o total, para que base + IVA = total sempre.
+            $base = (int) floor($precoCentimos / (1 + $taxa / 100) + 1e-9);
+
+            return self::formatar($base, $precoCentimos - $base, $taxa);
+        }
+
+        $iva = (int) ceil($precoCentimos * $taxa / 100 - 1e-9);
+
+        return self::formatar($precoCentimos, $iva, $taxa);
+    }
+
+    /**
+     * @return array{base: string, iva: string, total: string, taxa: string}
+     */
+    private static function formatar(int $base, int $iva, float $taxa): array
+    {
+        return [
+            'base' => number_format($base / 100, 2, '.', ''),
+            'iva' => number_format($iva / 100, 2, '.', ''),
+            'total' => number_format(($base + $iva) / 100, 2, '.', ''),
+            'taxa' => number_format($taxa, 2, '.', ''),
+        ];
+    }
+}
