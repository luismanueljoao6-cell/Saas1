+            'password' => 'Senha-Forte-123!',
+            'ativo' => true,
+        ]);
+    }
+
+    protected function ativarSubscricao(Empresa $empresa, Plano $plano): Subscricao
+    {
+        $pagamento = app(SubscricaoService::class)->iniciar($empresa, $plano);
+        app(PagamentoService::class)->confirmar($pagamento, [], null, '9900.00');
+
+        return Subscricao::withoutGlobalScopes()->where('empresa_id', $empresa->id)->firstOrFail();
+    }
+
+    // ---------------------------------------------------------------- preço
+
+    public function test_renovacao_cobra_o_preco_contratado_por_omissao(): void
+    {
+        [$empresa, $plano] = $this->cenario('820000001');
+        $subscricao = $this->ativarSubscricao($empresa, $plano);
+
+        $plano->update(['preco' => 12000]);
+
+        $renovacao = app(SubscricaoService::class)->gerarRenovacao($subscricao->fresh());
+
+        $this->assertSame('9900.00', (string) $renovacao->valor);
+    }
+
+    public function test_renovacao_pode_cobrar_o_preco_atual_do_catalogo(): void
+    {
+        config(['subscricoes.renovacao_usa_preco_contratado' => false]);
+
+        [$empresa, $plano] = $this->cenario('820000002');
+        $subscricao = $this->ativarSubscricao($empresa, $plano);
+
+        $plano->update(['preco' => 12000]);
+
+        $renovacao = app(SubscricaoService::class)->gerarRenovacao($subscricao->fresh());
+
+        $this->assertSame('12000.00', (string) $renovacao->valor);
+    }
+
+    // ------------------------------------------------------ cache de limites
+
+    public function test_cache_de_limites_e_invalidada_quando_a_subscricao_muda(): void
+    {
+        [$empresa, $plano] = $this->cenario('820000003', ['limites' => ['max_utilizadores' => 5]]);
+        $subscricao = $this->ativarSubscricao($empresa, $plano);
+
+        $limites = app(LimitesDaEmpresa::class);
+        $this->assertSame(5, $limites->limite($empresa->fresh(), 'max_utilizadores'));
+
+        // Segunda leitura (vinda da memória) e depois alteração: tem de refletir.
+        $this->assertSame(5, $limites->limite($empresa->fresh(), 'max_utilizadores'));
+        $subscricao->update(['limites' => ['max_utilizadores' => 9]]);
+
+        $this->assertSame(9, $limites->limite($empresa->fresh(), 'max_utilizadores'));
+    }
+
+    // ------------------------------------------------- caixa de entrada
+
+    public function test_webhook_grava_o_evento_e_despacha_o_job(): void
+    {
+        Queue::fake();
+
+        $this->postJson(route('subscricoes.webhooks.proxypay'), ['reference' => '555', 'amount' => '9900.00'])
+            ->assertOk();
+
+        $evento = EventoWebhook::firstOrFail();
+        $this->assertSame('555', $evento->referencia_externa);
+        $this->assertSame(EventoWebhookEstado::Recebido->value, $evento->estado);
+
+        Queue::assertPushed(ProcessarPagamentoConfirmadoJob::class);
+    }
+
+    public function test_job_marca_o_evento_como_processado(): void
+    {
+        [$empresa, $plano] = $this->cenario('820000004');
+        $pagamento = app(SubscricaoService::class)->iniciar($empresa, $plano);
+
+        $evento = EventoWebhook::create([
+            'gateway' => 'gateway-teste',
+            'referencia_externa' => $pagamento->referencia_externa,
+            'valor' => '9900.00',
+        ]);
+
+        (new ProcessarPagamentoConfirmadoJob('gateway-teste', (string) $pagamento->referencia_externa, [], '9900.00', $evento->id))
+            ->handle(app(PagamentoService::class));
+
+        $evento->refresh();
+        $this->assertSame(EventoWebhookEstado::Processado->value, $evento->estado);
+        $this->assertNotNull($evento->processado_em);
+    }
+
+    public function test_job_marca_o_evento_como_falhado_quando_o_valor_nao_bate(): void
+    {
+        [$empresa, $plano] = $this->cenario('820000005');
+        $pagamento = app(SubscricaoService::class)->iniciar($empresa, $plano);
+
+        $evento = EventoWebhook::create([
+            'gateway' => 'gateway-teste',
+            'referencia_externa' => $pagamento->referencia_externa,
+            'valor' => '1.00',
+        ]);
+
+        (new ProcessarPagamentoConfirmadoJob('gateway-teste', (string) $pagamento->referencia_externa, [], '1.00', $evento->id))
+            ->handle(app(PagamentoService::class));
+
+        $this->assertSame(EventoWebhookEstado::Falhado->value, $evento->fresh()->estado);
+        $this->assertSame('pendente', Pagamento::withoutGlobalScopes()->find($pagamento->id)->estado);
+    }
+
+    public function test_comando_reenvia_eventos_recebidos_ha_mais_de_n_minutos(): void
+    {
+        Queue::fake();
+
+        $antigo = EventoWebhook::create(['gateway' => 'gateway-teste', 'referencia_externa' => 'A', 'valor' => '1.00']);
+        $antigo->forceFill(['created_at' => now()->subMinutes(30)])->save();
+        EventoWebhook::create(['gateway' => 'gateway-teste', 'referencia_externa' => 'B', 'valor' => '1.00']);
+
+        $this->artisan('subscricoes:reprocessar-webhooks')->assertExitCode(0);
+
+        Queue::assertPushed(ProcessarPagamentoConfirmadoJob::class, 1);
+    }
