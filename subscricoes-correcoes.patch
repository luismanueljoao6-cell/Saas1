diff --git a/Modules/Subscricoes/app/Services/Fiscal/JwsAssinador.php b/Modules/Subscricoes/app/Services/Fiscal/JwsAssinador.php
new file mode 100644
index 0000000..9fe74dc
--- /dev/null
+++ b/Modules/Subscricoes/app/Services/Fiscal/JwsAssinador.php
@@ -0,0 +1,72 @@
+<?php
+
+namespace Modules\Subscricoes\Services\Fiscal;
+
+use RuntimeException;
+
+/**
+ * Assinatura JWS (RS256 = RSA + SHA-256) na serialização compacta, como a AGT
+ * especifica para jwsSoftwareSignature, jwsDocumentSignature e jwsSignature:
+ * base64url(header).base64url(payload).base64url(assinatura).
+ * Fonte: documentação da AGT, "Estrutura das Assinaturas Digitais (JWS)".
+ */
+class JwsAssinador
+{
+    public function __construct(
+        protected string $chavePrivadaPem,
+        protected ?string $senha = null,
+    ) {}
+
+    public static function doFicheiro(string $caminho, ?string $senha = null): self
+    {
+        if (! is_readable($caminho)) {
+            throw new RuntimeException("Chave privada AGT ilegível em '{$caminho}'.");
+        }
+
+        return new self((string) file_get_contents($caminho), $senha);
+    }
+
+    /**
+     * @param  array<string, mixed>  $payload  Objeto completo a assinar (não campos concatenados).
+     */
+    public function assinar(array $payload): string
+    {
+        $cabecalho = $this->base64Url(json_encode(['alg' => 'RS256', 'typ' => 'JWT'], JSON_THROW_ON_ERROR));
+        $corpo = $this->base64Url(self::canonico($payload));
+        $dados = "{$cabecalho}.{$corpo}";
+
+        $chave = openssl_pkey_get_private($this->chavePrivadaPem, $this->senha ?? '');
+
+        if ($chave === false) {
+            throw new RuntimeException('Chave privada RSA inválida ou palavra-passe incorreta.');
+        }
+
+        $detalhes = openssl_pkey_get_details($chave);
+
+        if (($detalhes['bits'] ?? 0) < 2048) {
+            throw new RuntimeException('A AGT exige chaves RSA de pelo menos 2048 bits.');
+        }
+
+        if (! openssl_sign($dados, $assinatura, $chave, OPENSSL_ALGO_SHA256)) {
+            throw new RuntimeException('Falha ao assinar o documento (openssl_sign).');
+        }
+
+        return $dados.'.'.$this->base64Url($assinatura);
+    }
+
+    /**
+     * JSON canónico: sem espaços nem quebras de linha, aspas duplas, números
+     * sem formatação adicional.
+     *
+     * @param  array<string, mixed>  $payload
+     */
+    public static function canonico(array $payload): string
+    {
+        return json_encode($payload, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR);
+    }
+
+    protected function base64Url(string $dados): string
+    {
+        return rtrim(strtr(base64_encode($dados), '+/', '-_'), '=');
+    }
+}
