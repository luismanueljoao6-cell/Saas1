@@ -0,0 +1,51 @@
+<?php
+
+namespace Modules\Subscricoes\Console;
+
+use Illuminate\Console\Command;
+use Modules\Subscricoes\Enums\EventoWebhookEstado;
+use Modules\Subscricoes\Jobs\ProcessarPagamentoConfirmadoJob;
+use Modules\Subscricoes\Models\EventoWebhook;
+
+class ReprocessarWebhooksCommand extends Command
+{
+    protected $signature = 'subscricoes:reprocessar-webhooks
+                            {--minutos=10 : Só eventos recebidos há mais de N minutos}
+                            {--falhados : Inclui também os eventos falhados}';
+
+    protected $description = 'Volta a pôr na fila os webhooks de pagamento que não chegaram a ser processados';
+
+    public function handle(): int
+    {
+        $estados = [EventoWebhookEstado::Recebido->value];
+
+        if ($this->option('falhados')) {
+            $estados[] = EventoWebhookEstado::Falhado->value;
+        }
+
+        $total = 0;
+
+        EventoWebhook::query()
+            ->whereIn('estado', $estados)
+            ->whereNotNull('referencia_externa')
+            ->where('created_at', '<', now()->subMinutes((int) $this->option('minutos')))
+            ->orderBy('id')
+            ->chunkById(100, function ($eventos) use (&$total) {
+                foreach ($eventos as $evento) {
+                    ProcessarPagamentoConfirmadoJob::dispatch(
+                        $evento->gateway,
+                        (string) $evento->referencia_externa,
+                        $evento->payload ?? [],
+                        $evento->valor,
+                        $evento->id,
+                    );
+
+                    $total++;
+                }
+            });
+
+        $this->info("{$total} evento(s) reenviado(s) para a fila.");
+
+        return self::SUCCESS;
+    }
+}
