+use Illuminate\Bus\Queueable;
+use Illuminate\Contracts\Queue\ShouldQueue;
+use Illuminate\Foundation\Bus\Dispatchable;
+use Illuminate\Queue\InteractsWithQueue;
+use Illuminate\Support\Facades\Config;
+use Illuminate\Support\Facades\Log;
+use Modules\Core\Services\TenantManager;
+use Modules\Subscricoes\Contracts\EmissorDocumentoFiscalInterface;
+use Modules\Subscricoes\Enums\DocumentoFiscalEstado;
+use Modules\Subscricoes\Models\DocumentoFiscal;
+use Throwable;
+
+/**
+ * Consulta na AGT (obterEstado) os documentos enviados e ainda por validar, e
+ * volta a pôr em fila os que ficaram em erro técnico.
+ */
+class AtualizarEstadoDocumentosFiscaisJob implements ShouldQueue
+{
+    use Dispatchable, InteractsWithQueue, Queueable;
+
+    public function handle(TenantManager $tenantManager, EmissorDocumentoFiscalInterface $emissor): void
+    {
+        if (Config::get('subscricoes.fiscal.driver') !== 'agt') {
+            return;
+        }
+
+        $tenantManager->semTenant(function () use ($emissor) {
+            DocumentoFiscal::withoutGlobalScopes()
+                ->where('estado', DocumentoFiscalEstado::Enviado->value)
+                ->orderBy('id')
+                ->each(function (DocumentoFiscal $documento) use ($emissor) {
+                    try {
+                        $emissor->atualizarEstado($documento);
+                    } catch (Throwable $e) {
+                        Log::warning('Falha a consultar o estado de um documento fiscal', [
+                            'documento_id' => $documento->id,
+                            'erro' => $e->getMessage(),
+                        ]);
+                    }
+                });
+
+            DocumentoFiscal::withoutGlobalScopes()
+                ->whereIn('estado', [DocumentoFiscalEstado::Erro->value, DocumentoFiscalEstado::Pendente->value])
+                ->where('updated_at', '<', now()->subMinutes(30))
+                ->orderBy('id')
+                ->each(fn (DocumentoFiscal $d) => EmitirDocumentoFiscalJob::dispatch($d->pagamento_id));
+        });
+    }
+}
diff --git a/Modules/Subscricoes/app/Jobs/EmitirDocumentoFiscalJob.php b/Modules/Subscricoes/app/Jobs/EmitirDocumentoFiscalJob.php
new file mode 100644
index 0000000..1f5e386
--- /dev/null
+++ b/Modules/Subscricoes/app/Jobs/EmitirDocumentoFiscalJob.php
@@ -0,0 +1,91 @@
+<?php
+
+namespace Modules\Subscricoes\Jobs;
+
+use Illuminate\Bus\Queueable;
+use Illuminate\Contracts\Queue\ShouldQueue;
+use Illuminate\Foundation\Bus\Dispatchable;
+use Illuminate\Queue\InteractsWithQueue;
+use Illuminate\Queue\SerializesModels;
+use Illuminate\Support\Facades\Config;
+use Illuminate\Support\Facades\Log;
+use Modules\Core\Services\TenantManager;
+use Modules\Subscricoes\Contracts\EmissorDocumentoFiscalInterface;
+use Modules\Subscricoes\Enums\DocumentoFiscalEstado;
+use Modules\Subscricoes\Enums\PagamentoEstado;
+use Modules\Subscricoes\Models\Pagamento;
+use Modules\Subscricoes\Services\Fiscal\DocumentoFiscalService;
+use Throwable;
+
+/**
+ * Cria o documento fiscal de um pagamento confirmado e, no driver 'agt',
+ * numera-o e comunica-o à AGT. A AGT penaliza faturas comunicadas com mais de
+ * 24 h de atraso, por isso este job repete com backoff curto.
+ */
+class EmitirDocumentoFiscalJob implements ShouldQueue
+{
+    use Dispatchable, InteractsWithQueue, Queueable, SerializesModels;
+
+    public int $tries = 8;
+
+    /** @return array<int, int> */
+    public function backoff(): array
+    {
+        return [30, 120, 600, 1800, 3600, 7200, 14400];
+    }
+
+    public function __construct(protected int $pagamentoId) {}
+
+    public function handle(
+        TenantManager $tenantManager,
+        DocumentoFiscalService $servico,
+        EmissorDocumentoFiscalInterface $emissor,
+    ): void {
+        $driver = (string) Config::get('subscricoes.fiscal.driver', 'manual');
+
+        if ($driver === 'desativado') {
+            return;
+        }
+
+        $tenantManager->semTenant(function () use ($servico, $emissor, $driver) {
+            $pagamento = Pagamento::withoutGlobalScopes()->find($this->pagamentoId);
+
+            if (! $pagamento || $pagamento->estado !== PagamentoEstado::Confirmado->value) {
+                return;
+            }
+
+            $documento = $servico->criarParaPagamento($pagamento);
+
+            // 'manual': fica pendente até alguém registar o número externo.
+            if ($driver !== 'agt') {
+                return;
+            }
+
+            if (in_array($documento->estado, [
+                DocumentoFiscalEstado::Enviado->value,
+                DocumentoFiscalEstado::Validado->value,
+                DocumentoFiscalEstado::Externo->value,
+                DocumentoFiscalEstado::Rejeitado->value,
+            ], true)) {
+                return;
+            }
+
+            try {
+                $servico->atribuirNumero($documento);
+                $emissor->emitir($documento);
+            } catch (Throwable $e) {
+                $documento->forceFill([
+                    'estado' => DocumentoFiscalEstado::Erro->value,
+                    'erro' => $e->getMessage(),
+                ])->save();
+
+                Log::error('Falha ao emitir documento fiscal', [
+                    'pagamento_id' => $this->pagamentoId,
+                    'erro' => $e->getMessage(),
+                ]);
+
+                throw $e;
+            }
+        });
+    }
+}
