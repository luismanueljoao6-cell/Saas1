+<?php
+
+namespace Modules\Subscricoes\Http\Controllers\Admin;
+
+use DomainException;
+use Illuminate\Http\RedirectResponse;
+use Illuminate\Http\Request;
+use Illuminate\Routing\Controller;
+use Illuminate\View\View;
+use Modules\Core\Services\TenantManager;
+use Modules\Subscricoes\Models\Pagamento;
+use Modules\Subscricoes\Services\PagamentoService;
+use Throwable;
+
+/**
+ * Reconciliação manual (ex.: transferência bancária) — só super admins da
+ * plataforma. Um super admin não tem tenant, por isso as leituras fazem
+ * bypass explícito e deliberado através do TenantManager::semTenant().
+ */
+class PagamentoManualController extends Controller
+{
+    public function __construct(
+        protected PagamentoService $pagamentoService,
+        protected TenantManager $tenantManager,
+    ) {}
+
+    public function index(Request $request): View
+    {
+        abort_unless($request->user()?->is_super_admin, 403);
+
+        $pagamentos = $this->tenantManager->semTenant(fn () => Pagamento::query()
+            ->whereIn('estado', ['pendente', 'expirado', 'falhado'])
+            ->with(['empresa', 'subscricao.plano'])
+            ->latest('id')
+            ->limit(100)
+            ->get());
+
+        return view('subscricoes::admin.pagamentos', ['pagamentos' => $pagamentos]);
+    }
+
+    public function confirmar(Request $request, int $pagamento): RedirectResponse
+    {
+        abort_unless($request->user()?->is_super_admin, 403);
+
+        $modelo = $this->tenantManager->semTenant(fn () => Pagamento::query()->findOrFail($pagamento));
+
+        try {
+            $this->pagamentoService->confirmar(
+                $modelo,
+                ['confirmacao_manual' => true, 'confirmado_por' => $request->user()->id],
+                $request->user(),
+            );
+        } catch (DomainException $e) {
+            return back()->with('erro', $e->getMessage());
+        } catch (Throwable) {
+            return back()->with('erro', 'Não foi possível confirmar o pagamento. Consulta o log para o detalhe.');
+        }
+
+        return back()->with('sucesso', "Pagamento {$modelo->id} confirmado e subscrição ativada.");
+    }
+}
