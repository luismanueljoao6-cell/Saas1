APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_PT

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Plataforma ---
APP_TIMEZONE=Africa/Luanda
# IMPORTANTE: tem de ser MAIOR que o timeout do GerarSafTJob (600 s)
DB_QUEUE_RETRY_AFTER=660

# --- Faturação ---
# Vazio = storage/app/faturacao/chave-privada.pem (gera-a conforme o README)
# FATURACAO_CHAVE_PRIVADA_PATH=
# Pasta com as chaves privadas emitidas pela AGT, uma por empresa: {NIF}.pem
# FATURACAO_CHAVES_DIR=
# FATURACAO_CHAVE_PUBLICA_PATH=
FATURACAO_CHAVE_VERSAO=1
FATURACAO_TAXA_IVA_GERAL=14
# Taxas aceites na emissão (confirma na tabela atual da AGT). Para aceitar isenções: 14,0
FATURACAO_TAXAS_IVA_PERMITIDAS=14
# Em produção, o SAF-T é bloqueado enquanto isto for 0
FATURACAO_SAFT_NUMERO_CERTIFICADO=0
# XSD OFICIAL do SAF-T (AO), por omissão storage/app/faturacao/saft/SAF-T-AO.xsd: sem ele, em produção,
# nenhum SAF-T é publicado
# FATURACAO_SAFT_XSD_PATH=
# Só true depois de comparares a tabela faturacao.motivos_isencao com o Anexo 6.4 oficial.
# Enquanto for false, com a AGT ativa as isenções e as notas de débito não são aceites/enviadas.
FATURACAO_MOTIVOS_ISENCAO_CONFIRMADOS=false
# Notas de débito: por omissão seguem para a AGT sem bloco "taxes". Para as enviar como não sujeitas,
# define o código (tipo NS da tabela de motivos; exige a tabela confirmada)
# FATURACAO_AGT_ND_CODIGO_NS=

# --- Segurança / proxies ---
# IPs do teu proxy/load balancer, separados por vírgula. Vazio = não confiar em ninguém.
# (No GitHub Codespaces confia-se automaticamente.)
# TRUSTED_PROXIES=

# --- ProxyPay (sandbox: https://api.sandbox.proxypay.co.ao) ---
SUBSCRICOES_GATEWAY=proxypay
PROXYPAY_BASE_URL=https://api.sandbox.proxypay.co.ao
PROXYPAY_API_KEY=
PROXYPAY_ENTITY_ID=
# Webhook: configura na ProxyPay o URL https://SEU-DOMINIO/api/webhooks/proxypay
# (sem token na query string: o pedido é validado pela assinatura X-Signature,
# HMAC-SHA-256 do corpo com a PROXYPAY_API_KEY).

# --- Estúdio de Música (por omissão 'log': só regista, não envia) ---
ESTUDIOMUSICA_CANAL_WHATSAPP=log
ESTUDIOMUSICA_CANAL_SMS=log

# --- Comunicação com a AGT (Facturação Electrónica) ---
FATURACAO_AGT_ATIVO=false
FATURACAO_AGT_AMBIENTE=homologacao
# Credenciais Basic Auth pedidas à AGT (produtores.dfe.dcrr.agt@minfin.gov.ao)
# FATURACAO_AGT_UTILIZADOR=
# FATURACAO_AGT_PALAVRA_PASSE=
FATURACAO_AGT_ESTABELECIMENTO=SEDE
# FATURACAO_AGT_PRODUCT_ID=Saas1
# FATURACAO_AGT_PRODUCT_VERSION=1.0.0
# Chave privada RSA (>= 2048 bits) do SOFTWARE, registada na AGT
# FATURACAO_AGT_CHAVE_SOFTWARE=

# Pré-visualizações do portal (precisa de ffmpeg instalado no servidor)
ESTUDIOMUSICA_FFMPEG_BIN=ffmpeg
# Transferência internacional (WhatsApp/SMS) — Lei 22/11: canais bloqueados até haver autorização da APD
ESTUDIOMUSICA_EXIGIR_AUTORIZACAO_APD=true
# ESTUDIOMUSICA_APD_AUTORIZACAO=
# ESTUDIOMUSICA_APD_REGISTO=
SUBSCRICOES_RENOVACAO_PRECO=contratado

# --- Chaves opcionais dos módulos (todas com valor por omissão no código) ---
# Descomenta só o que precisares de alterar. A descrição de cada chave está em
# Modules/<Módulo>/config/config.php.

# Core
# CORE_TRIAL_DIAS=14
# CORE_PERIODO_TOLERANCIA_DIAS=5
# CORE_SUPER_ADMIN_EMAILS=
# CORE_AUTH_GUARD=web

# Subscrições
# SUBSCRICOES_MOEDA=AOA
# SUBSCRICOES_VALIDADE_REFERENCIA_DIAS=3
# SUBSCRICOES_AVISO_RENOVACAO_DIAS=3
# SUBSCRICOES_TRIAL_MAX_UTILIZADORES=3
# SUBSCRICOES_TRIAL_MAX_FATURAS_MES=50

# Faturação / AGT
# FATURACAO_ND_LIQUIDA_IVA=false
# FATURACAO_AGT_URL_HOMOLOGACAO=https://sifphml.minfin.gov.ao/sigt/fe/v1
# FATURACAO_AGT_URL_PRODUCAO=https://sifp.minfin.gov.ao/sigt/fe/v1
# FATURACAO_AGT_TIMEOUT=20
# FATURACAO_AGT_MAX_TENTATIVAS=5
# FATURACAO_AGT_CONSULTA_INTERVALO=60
# FATURACAO_AGT_SEM_RESPOSTA_HORAS=24
# FATURACAO_AGT_OPERATION_TYPE=SG
# FATURACAO_AGT_SIGNATURE_VERSION=

# Atelier
# ATELIER_CANAIS_NOTIFICACAO=mail
# ATELIER_WHATSAPP_BASE_URL=
# ATELIER_WHATSAPP_TOKEN=
# ATELIER_WHATSAPP_NUMERO_ID=
# ATELIER_SMS_BASE_URL=
# ATELIER_SMS_API_KEY=
# ATELIER_SMS_REMETENTE=ATELIER
# ATELIER_LEMBRETE_PROVA_HORAS=24
# ATELIER_MESES_INATIVIDADE=6
# ATELIER_PORTAL_LINK_DIAS=7

# Estúdio de Música
# ESTUDIOMUSICA_PERCENTUAL_SINAL_PADRAO=40
# ESTUDIOMUSICA_DESCONTO_ANIVERSARIO=15
# ESTUDIOMUSICA_VALIDADE_CUPOM_DIAS=30
# ESTUDIOMUSICA_PORTAL_TOKEN_VALIDADE_DIAS=30
# WHATSAPP_CLOUD_API_BASE_URL=https://graph.facebook.com/v21.0
# WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=
# WHATSAPP_CLOUD_API_TOKEN=
# SMS_TWILIO_ACCOUNT_SID=
# SMS_TWILIO_AUTH_TOKEN=
# SMS_TWILIO_NUMERO_REMETENTE=

# --- Sessão e cookies (produção atrás de HTTPS) ---
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax
# SESSION_HTTP_ONLY=true
# Rotação da APP_KEY: chaves antigas separadas por vírgula.
# APP_PREVIOUS_KEYS=
