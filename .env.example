APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_PT

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Plataforma ---
APP_TIMEZONE=Africa/Luanda
# IMPORTANTE: tem de ser MAIOR que o timeout do GerarSafTJob (600 s)
DB_QUEUE_RETRY_AFTER=660

# --- Faturação ---
# Vazio = storage/app/faturacao/chave-privada.pem (gera-a conforme o README)
# FATURACAO_CHAVE_PRIVADA_PATH=
# Pasta com as chaves privadas emitidas pela AGT, uma por empresa: {NIF}.pem
# FATURACAO_CHAVES_DIR=
FATURACAO_CHAVE_VERSAO=1
FATURACAO_TAXA_IVA_GERAL=14
# Taxas aceites na emissão (confirma na tabela atual da AGT)
FATURACAO_TAXAS_IVA_PERMITIDAS=14
# Em produção, o SAF-T é bloqueado enquanto isto for 0
FATURACAO_SAFT_NUMERO_CERTIFICADO=0

# --- Segurança / proxies ---
# IPs do teu proxy/load balancer, separados por vírgula. Vazio = não confiar em ninguém.
# (No GitHub Codespaces confia-se automaticamente.)
# TRUSTED_PROXIES=

# --- ProxyPay (sandbox: https://api.sandbox.proxypay.co.ao) ---
SUBSCRICOES_GATEWAY=proxypay
PROXYPAY_BASE_URL=https://api.sandbox.proxypay.co.ao
PROXYPAY_API_KEY=
PROXYPAY_ENTITY_ID=
# Segredo do webhook: configura na ProxyPay o URL
#   https://SEU-DOMINIO/api/webhooks/proxypay?token=<este valor>
PROXYPAY_WEBHOOK_TOKEN=

# --- Estúdio de Música (por omissão 'log': só regista, não envia) ---
ESTUDIOMUSICA_CANAL_WHATSAPP=log
ESTUDIOMUSICA_CANAL_SMS=log

# --- Comunicação com a AGT (Facturação Electrónica) ---
FATURACAO_AGT_ATIVO=false
FATURACAO_AGT_AMBIENTE=homologacao
# Credenciais Basic Auth pedidas à AGT (produtores.dfe.dcrr.agt@minfin.gov.ao)
# FATURACAO_AGT_UTILIZADOR=
# FATURACAO_AGT_PALAVRA_PASSE=
FATURACAO_AGT_ESTABELECIMENTO=SEDE
# FATURACAO_AGT_PRODUCT_ID=Saas1
# FATURACAO_AGT_PRODUCT_VERSION=1.0.0
# Chave privada RSA (>= 2048 bits) do SOFTWARE, registada na AGT
# FATURACAO_AGT_CHAVE_SOFTWARE=

# Pré-visualizações do portal (precisa de ffmpeg instalado no servidor)
ESTUDIOMUSICA_FFMPEG_BIN=ffmpeg
# Transferência internacional (WhatsApp/SMS) — Lei 22/11: canais bloqueados até haver autorização da APD
ESTUDIOMUSICA_EXIGIR_AUTORIZACAO_APD=true
# ESTUDIOMUSICA_APD_AUTORIZACAO=
# ESTUDIOMUSICA_APD_REGISTO=
