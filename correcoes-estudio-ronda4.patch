@@ -0,0 +1,129 @@
+<?php
+
+namespace Modules\EstudioMusica\Tests\Feature;
+
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Modules\Core\Models\Empresa;
+use Modules\Core\Services\TenantManager;
+use Modules\EstudioMusica\Models\FaixaMusical;
+use Modules\EstudioMusica\Models\ProjetoMusical;
+use Modules\EstudioMusica\Models\VersaoAudio;
+use Modules\Faturacao\Models\Cliente;
+use Tests\TestCase;
+
+/**
+ * Portal: o cliente só aprova versões depois de aceitar os Termos de
+ * Serviço (propriedade dos masters), e só decide sobre a versão mais recente.
+ */
+class PortalTermosTest extends TestCase
+{
+    use RefreshDatabase;
+
+    protected const TOKEN = 'token-de-teste-portal-0123456789abcdef0123456789';
+
+    protected Empresa $empresa;
+
+    protected Cliente $cliente;
+
+    protected VersaoAudio $versao;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        $this->withoutVite();
+
+        $this->empresa = Empresa::create(['nome_comercial' => 'Estúdio Portal', 'nif' => '400000008']);
+        app(TenantManager::class)->set($this->empresa->id);
+
+        $this->cliente = (new Cliente)->forceFill([
+            'empresa_id' => $this->empresa->id,
+            'nome' => 'Artista Portal',
+            'token_portal' => hash('sha256', self::TOKEN),
+            'token_portal_expira_em' => now()->addDay(),
+        ]);
+        $this->cliente->save();
+
+        $projeto = ProjetoMusical::create([
+            'empresa_id' => $this->empresa->id,
+            'cliente_id' => $this->cliente->id,
+            'nome' => 'Projeto Portal',
+            'tipo_cobranca' => 'hora',
+        ]);
+        $faixa = FaixaMusical::create([
+            'empresa_id' => $this->empresa->id,
+            'projeto_musical_id' => $projeto->id,
+            'nome' => 'Faixa 1',
+            'ordem' => 1,
+        ]);
+        $this->versao = VersaoAudio::create([
+            'empresa_id' => $this->empresa->id,
+            'faixa_musical_id' => $faixa->id,
+            'rotulo' => 'Mix v1',
+            'caminho_ficheiro' => 'estudiomusica/versoes-audio/inexistente.wav',
+            'estado' => 'pendente_aprovacao',
+            'enviada_em' => now(),
+        ]);
+    }
+
+    protected function rota(string $nome): string
+    {
+        return route("estudiomusica.portal.{$nome}", ['token' => self::TOKEN, 'versao' => $this->versao->id]);
+    }
+
+    public function test_portal_pede_aceite_dos_termos_e_esconde_o_pedido_depois_de_aceitar(): void
+    {
+        $this->get(route('estudiomusica.portal.mostrar', ['token' => self::TOKEN]))
+            ->assertOk()
+            ->assertSee('Li e aceito');
+
+        $this->post(route('estudiomusica.portal.termos.aceitar', ['token' => self::TOKEN]))->assertRedirect();
+
+        $this->get(route('estudiomusica.portal.mostrar', ['token' => self::TOKEN]))
+            ->assertOk()
+            ->assertDontSee('Li e aceito');
+    }
+
+    public function test_aprovar_antes_de_aceitar_os_termos_e_recusado(): void
+    {
+        $this->post($this->rota('versoes.aprovar'))->assertSessionHas('erro');
+
+        $this->assertSame('pendente_aprovacao', $this->versao->fresh()->estado);
+    }
+
+    public function test_aprovar_depois_de_aceitar_os_termos_funciona(): void
+    {
+        $this->post(route('estudiomusica.portal.termos.aceitar', ['token' => self::TOKEN]));
+
+        $this->post($this->rota('versoes.aprovar'))->assertSessionMissing('erro');
+
+        $this->assertSame('aprovada', $this->versao->fresh()->estado);
+    }
+
+    public function test_so_a_versao_mais_recente_aceita_decisao(): void
+    {
+        $this->post(route('estudiomusica.portal.termos.aceitar', ['token' => self::TOKEN]));
+
+        VersaoAudio::create([
+            'empresa_id' => $this->empresa->id,
+            'faixa_musical_id' => $this->versao->faixa_musical_id,
+            'rotulo' => 'Mix v2',
+            'caminho_ficheiro' => 'estudiomusica/versoes-audio/inexistente2.wav',
+            'estado' => 'pendente_aprovacao',
+            'enviada_em' => now()->addMinute(),
+        ]);
+
+        $this->post($this->rota('versoes.aprovar'))->assertSessionHas('erro');
+
+        $this->assertSame('pendente_aprovacao', $this->versao->fresh()->estado);
+    }
+
+    public function test_resposta_do_portal_nao_e_cacheavel_e_nao_vaza_o_referer(): void
+    {
+        $resposta = $this->get(route('estudiomusica.portal.mostrar', ['token' => self::TOKEN]));
+
+        $resposta->assertHeader('Referrer-Policy', 'no-referrer');
+        $resposta->assertHeader('X-Robots-Tag', 'noindex, nofollow');
+        $this->assertStringContainsString('no-store', $resposta->headers->get('Cache-Control'));
+    }
+}
diff --git a/Modules/EstudioMusica/tests/Feature/TermosEstudioTest.php b/Modules/EstudioMusica/tests/Feature/TermosEstudioTest.php
new file mode 100644
index 0000000..d204009
--- /dev/null
+++ b/Modules/EstudioMusica/tests/Feature/TermosEstudioTest.php
@@ -0,0 +1,83 @@
+<?php
+
+namespace Modules\EstudioMusica\Tests\Feature;
+
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Http\Request;
+use Modules\Core\Models\Empresa;
+use Modules\Core\Services\TenantManager;
+use Modules\EstudioMusica\Models\AceiteTermos;
+use Modules\EstudioMusica\Models\TermosEstudio;
+use Modules\EstudioMusica\Services\TermosEstudioService;
+use Modules\Faturacao\Models\Cliente;
+use Tests\TestCase;
+
+class TermosEstudioTest extends TestCase
+{
+    use RefreshDatabase;
+
+    protected Empresa $empresa;
+
+    protected Cliente $cliente;
+
+    protected TermosEstudioService $servico;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        $this->empresa = Empresa::create(['nome_comercial' => 'Estúdio Termos', 'nif' => '400000005']);
+        app(TenantManager::class)->set($this->empresa->id);
+
+        $this->cliente = Cliente::create(['empresa_id' => $this->empresa->id, 'nome' => 'Artista Teste']);
+        $this->servico = app(TermosEstudioService::class);
+    }
+
+    public function test_primeira_consulta_cria_a_versao_1_a_partir_do_modelo_e_nao_duplica(): void
+    {
+        $a = $this->servico->atual($this->empresa->id, 'Estúdio Termos');
+        $b = $this->servico->atual($this->empresa->id, 'Estúdio Termos');
+
+        $this->assertSame(1, $a->versao);
+        $this->assertSame($a->id, $b->id);
+        $this->assertSame(1, TermosEstudio::query()->count());
+        $this->assertStringContainsString('Direitos de autor', $a->conteudo);
+        $this->assertStringContainsString('Estúdio Termos', $a->conteudo);
+    }
+
+    public function test_aceite_e_idempotente(): void
+    {
+        $termos = $this->servico->atual($this->empresa->id);
+
+        $this->servico->registarAceite($this->cliente, $termos, Request::create('/'));
+        $this->servico->registarAceite($this->cliente, $termos, Request::create('/'));
+
+        $this->assertTrue($this->servico->aceitou($this->cliente, $termos));
+        $this->assertSame(1, AceiteTermos::query()->count());
+    }
+
+    public function test_nova_versao_obriga_a_novo_aceite(): void
+    {
+        $v1 = $this->servico->atual($this->empresa->id);
+        $this->servico->registarAceite($this->cliente, $v1, Request::create('/'));
+
+        $v2 = $this->servico->publicar($this->empresa->id, 'Termos 2', str_repeat('Cláusula. ', 20));
+
+        $this->assertSame(2, $v2->versao);
+        $this->assertSame($v2->id, $this->servico->atual($this->empresa->id)->id);
+        $this->assertFalse($this->servico->aceitou($this->cliente, $v2));
+        $this->assertTrue($this->servico->aceitou($this->cliente, $v1), 'o aceite antigo fica como prova');
+    }
+
+    public function test_o_ip_nunca_e_guardado_em_claro(): void
+    {
+        $termos = $this->servico->atual($this->empresa->id);
+        $pedido = Request::create('/', 'GET', [], [], [], ['REMOTE_ADDR' => '203.0.113.7']);
+
+        $aceite = $this->servico->registarAceite($this->cliente, $termos, $pedido);
+
+        $this->assertNotNull($aceite->ip_hash);
+        $this->assertStringNotContainsString('203.0.113.7', $aceite->ip_hash);
+        $this->assertSame(64, strlen($aceite->ip_hash));
+    }
+}
